CREATE TABLE `temp_apvs` (
`temp_apv_id` int(11) NOT NULL AUTO_INCREMENT,
`temp_apv_num` varchar(45) NOT NULL,
`batch_num` varchar(45) NOT NULL,
`vendor_code` varchar(45) DEFAULT NULL,
`reference_num` varchar(45) DEFAULT NULL,
`apv_date` datetime DEFAULT NULL,
`apv_amount` decimal(10,2) DEFAULT NULL,
`cv_num` varchar(45) DEFAULT NULL,
`cv_amount` decimal(10,2) DEFAULT NULL,
`particulars` varchar(45) DEFAULT NULL,
`apv_status_code` int(11) DEFAULT NULL,
`created_date` datetime DEFAULT CURRENT_TIMESTAMP,
`created_by` mediumint(8) DEFAULT NULL,
PRIMARY KEY (`temp_apv_id`),
KEY `temp_apv_vendor_code_idx` (`vendor_code`),
KEY `temp_apv_status_code_idx` (`apv_status_code`),
CONSTRAINT `temp_apv_vendor_code` FOREIGN KEY (`vendor_code`) REFERENCES `vendors` (`vendor_code`) ON DELETE NO ACTION ON UPDATE NO ACTION,
CONSTRAINT `temp_apv_status_code` FOREIGN KEY (`apv_status_code`) REFERENCES `param_apv_status` (`apv_status_id`) ON DELETE NO ACTION ON UPDATE NO ACTION
) ENGINE=InnoDB AUTO_INCREMENT=1 DEFAULT CHARSET=utf8;

