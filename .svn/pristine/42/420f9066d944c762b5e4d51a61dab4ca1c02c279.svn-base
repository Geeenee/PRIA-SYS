			throw $e;
		}catch(Exception $e){
			throw $e;
		}
	}

	public function delete_user($user_id) {
		try {
			$query = "
				SET FOREIGN_KEY_CHECKS = 0;

				DELETE FROM ". parent::CORE_TABLE_USERS ."
				WHERE user_id = ?;

				SET FOREIGN_KEY_CHECKS = 1;
			";

			$this->query($query, array($user_id), FALSE, FALSE);
		} catch (PDOException $e) {
			throw $e;
		}
	}

