<div>
	<div class="font-lg m-b-md">Clean-Up Report</div>
	<div class="row b-t-n m-b-n">
		<div class="col l1 m2 s2 p-l-lg">
			<input type="checkbox" class="labelauty rounded" name="dr_chk[]" value="1" />
		</div>
		<div class="col l8 m7 s8">
			<div class="font-lg">Return / Approve Clean-Up Report <div class="help-text font-sm m-t-xs">assigned to <span class="font-bold">CG Liq Finance	</span></div></div>
		</div>
		<div class="col l3 m3 s2 right-align">
			<span class="badge rounded pink lighten-5">Pending</span>
		</div>
	</div>
	
	<!-- DATA ENTRY FORMS -->
	<div class="row b-t-n m-b-n">
		<div class="col l1 m2 s1"></div>
		<div class="col l11 m10 s11">
			<div class="panel-wrapper white">
				<div class="input-field m-b-md">
					<div class="table-display">
						<div class="table-cell l3 m5 s5 right-align valign-middle p-r-md">			
							<label class="required font-bold">Clean-Up Date</label>
						</div>

						<div class="table-cell l5 m6 s6 valign-middle">11/24/2018</div>
						<div class="table-cell l4 m1 s1 valign-middle"></div>
					</div>
				</div>
				<div class="input-field m-b-md">
					<div class="table-display">
						<div class="table-cell l3 m5 s5 right-align valign-middle p-r-md">			
							<label class="required font-bold">Harvested Heads</label>
						</div>

						<div class="table-cell l5 m6 s6 valign-middle">32</div>
						<div class="table-cell l4 m1 s1 valign-middle"></div>
					</div>
				</div>
				<div class="input-field m-b-md">
					<div class="table-display">
						<div class="table-cell l3 m5 s5 right-align valign-middle p-r-md">			
							<label class="required font-bold">Feeds Delivered</label>
						</div>

						<div class="table-cell l5 m6 s6 valign-middle">522</div>
						<div class="table-cell l4 m1 s1 valign-middle"></div>
					</div>
				</div>
				<div class="input-field m-b-md">
					<div class="table-display">
						<div class="table-cell l3 m5 s5 right-align valign-middle p-r-md">			
							<label class="required font-bold">Feeds Used</label>
						</div>

						<div class="table-cell l5 m6 s6 valign-middle">313</div>
						<div class="table-cell l4 m1 s1 valign-middle"></div>
					</div>
				</div>
				<div class="input-field m-b-md">
					<div class="table-display">
						<div class="table-cell l3 m5 s5 right-align valign-middle p-r-md">			
							<label class="required font-bold">MedVac DR No.</label>
						</div>

						<div class="table-cell l5 m6 s6 valign-middle">DR 000001</div>
						<div class="table-cell l4 m1 s1 valign-middle"></div>
					</div>
				</div>
				<div class="input-field m-b-lg">
					<div class="table-display">
						<div class="table-cell l3 m5 s5 right-align valign-middle p-r-md">			
							<label class="required font-bold">DOC GR No.</label>
						</div>

						<div class="table-cell l5 m6 s6 valign-middle">GR 000001</div>
						<div class="table-cell l4 m1 s1 valign-middle"></div>
					</div>
				</div>
				<div class="input-field">
					<div class="table-display">
						<div class="table-cell s3 right-align valign-middle p-r-md"></div>

						<div class="table-cell s9 valign-middle">
							<button type="submit" class="btn m-r-sm">Return</button>
							<button type="submit" class="btn">Approve</button>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
