<div>
	<div class="font-lg m-b-md">MedVac Delivery</div>
	<div class="row b-t-n m-b-n">
		<div class="col l1 m2 s2 p-l-lg">
			<input type="checkbox" class="labelauty rounded" name="dr_chk[]" value="1" />
		</div>
		<div class="col l8 m7 s8">
			<div class="font-lg">Encode MedVac Delivery Receipt <div class="help-text font-sm m-t-xs">assigned to <span class="font-bold">BC Admin</span></div></div>
		</div>
		<div class="col l3 m3 s2 right-align">
			<span class="badge rounded pink lighten-5">Pending</span>
		</div>
	</div>
	
	<!-- DATA ENTRY FORMS -->
	<div class="row b-t-n m-b-n">
		<div class="col l1 m2 s1"></div>
		<div class="col l11 m10 s11">
			<div class="panel-wrapper white">
				<div class="input-field m-n">
					<div class="row m-b-n p-n">
						<div class="col l3 m4 s12 right-align label-col  p-r-md">			
							<label class="required">DR Transaction No. (SAP)</label>
						</div>

						<div class="col  l3 m6 s6  ">
							<input type="text" name="dr_transaction_no" id="dr_transaction_no" placeholder="Enter DR Transaction Number" />
						</div>
					</div>
				</div>
				<div class="input-field m-n">
					<div class="row m-b-n p-n">
						<div class="col l3 m4 s12 right-align label-col  p-r-md">			
							<label>DR Date</label>
						</div>

						<div class="col l3 m6 s6  ">
							<input type="text" class="datetimepicker" name="medvac_dr_date" id="medvac_dr_date" placeholder="Enter DR Date" />
						</div>
						<div class="col l6 m1 s1  "></div>
					</div>
				</div>
				<div class="input-field m-n">
					<div class="row m-b-n p-n">
						<div class="col l3 m4 s12 right-align label-col  p-r-md">			
							<label>Transaction Date (per IO)</label>
						</div>

						<div class="col l3 m6 s6  ">
							<input type="text" class="datetimepicker" name="transaction_date" id="transaction_date" placeholder="Enter Transaction Date"/>
						</div>
						<div class="col l6 m1 s1  "></div>
					</div>
				</div>
				<div class="input-field m-n">
					<div class="row m-b-n p-n">
						<div class="col l3 m4 s12 right-align label-col  p-r-md">			
							<label>Last MedVac Delivery?</label>
						</div>

						<div class="col l9 m7 s7  ">
							<div class="input-field m-n">
								<input type="checkbox" class="filled-in" name="medvac_deliveries" id="medvac_deliveries" />
								<label for="medvac_deliveries">Checking this box will signify completion of all MedVac deliveries</label>
							</div>
						</div>
					</div>
				</div>
				<div class="input-field m-n">
					<div class="row m-b-n p-n">
						<div class="col s3 right-align   p-r-md"></div>
						<div class="col s9  ">
							<button type="submit" class="btn">Save</button>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
