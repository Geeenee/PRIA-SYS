CREATE TABLE `email_notification_queues` (
  `email_notification_queue_id` int(11) unsigned NOT NULL AUTO_INCREMENT,
  `from_user` mediumint(8) unsigned NOT NULL,
  `to_user` mediumint(8) unsigned NOT NULL,
  `message` text NOT NULL,
  `email_data` varchar(255) DEFAULT NULL COMMENT 'Email Data',
  `created_date` datetime NOT NULL COMMENT 'Date when message was created',
  `sent_flag` enum('Y','N') NOT NULL COMMENT 'Y=message already sent',
  `sent_date` datetime DEFAULT NULL COMMENT 'Date when message sent',
  `resend_flag` enum('Y','N') DEFAULT NULL COMMENT 'Y=message was sent',
  `resend_by` mediumint(8) unsigned DEFAULT NULL,
  `resend_date` datetime DEFAULT NULL COMMENT 'Date when message re-sent',
  `send_now_flag` enum('Y','N') DEFAULT NULL,
  `send_now_by` mediumint(8) unsigned DEFAULT NULL COMMENT 'Y=message was send without waiting for its turn (ex. priority message)',
  `send_now_date` datetime DEFAULT NULL COMMENT 'Y=Date when the message was sent',
  `failed_flag` enum('Y','N') DEFAULT NULL,
  `module_code` varchar(50) DEFAULT NULL,
  PRIMARY KEY (`email_notification_queue_id`),
  KEY `idx-email_notification_queue_id-from_user` (`from_user`),
  KEY `idx-email_notification_queue_id-to_user` (`to_user`),
  KEY `idx-email_notification_queue_id-resend_by` (`resend_by`),
  KEY `idx-email_notification_queue_id-send_now_by` (`send_now_by`),
  KEY `idx-email_notification_queue_id-module_code` (`module_code`) USING BTREE,
  CONSTRAINT `fk-email_notification_queue_id-from_user` FOREIGN KEY (`from_user`) REFERENCES `users` (`user_id`),
  CONSTRAINT `fk-email_notification_queue_id-resend_by` FOREIGN KEY (`resend_by`) REFERENCES `users` (`user_id`),
  CONSTRAINT `fk-email_notification_queue_id-send_now_by` FOREIGN KEY (`send_now_by`) REFERENCES `users` (`user_id`),
  CONSTRAINT `fk-email_notification_queue_id-to_user` FOREIGN KEY (`to_user`) REFERENCES `users` (`user_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8 COLLATE utf8_general_ci COMMENT='This table keeps all messages to send through EMAIL.';

CREATE TABLE `sms_notification_queues` (
  `sms_notification_queue_id` int(11) unsigned NOT NULL AUTO_INCREMENT,
  `from_user` mediumint(8) unsigned NOT NULL,
  `to_user` mediumint(8) unsigned NOT NULL,
  `message` text NOT NULL,
  `sms_data` varchar(255) DEFAULT NULL COMMENT 'Sms Data',
  `created_date` datetime NOT NULL COMMENT 'Date when message was created',
  `sent_flag` enum('Y','N') NOT NULL COMMENT 'Y=message already sent',
  `sent_date` datetime DEFAULT NULL COMMENT 'Date when message sent',
  `resend_flag` enum('Y','N') DEFAULT NULL COMMENT 'Y=message was sent',
  `resend_by` mediumint(8) unsigned DEFAULT NULL,
  `resend_date` datetime DEFAULT NULL COMMENT 'Date when message re-sent',
  `send_now_flag` enum('Y','N') DEFAULT NULL,
  `send_now_by` mediumint(8) unsigned DEFAULT NULL COMMENT 'Y=message was send without waiting for its turn (ex. priority message)',
  `send_now_date` datetime DEFAULT NULL COMMENT 'Y=Date when the message was sent',
  `failed_flag` enum('Y','N') DEFAULT NULL,
  `module_code` varchar(50) DEFAULT NULL,
  PRIMARY KEY (`sms_notification_queue_id`),
  KEY `idx-sms_notification_queues-from_user` (`from_user`),
  KEY `idx-sms_notification_queues-to_user` (`to_user`),
  KEY `idx-sms_notification_queues-resend_by` (`resend_by`),
  KEY `idx-sms_notification_queues-send_now_by` (`send_now_by`),
  KEY `idx-sms_notification_queues-module_code` (`module_code`) USING BTREE,
  CONSTRAINT `fk-sms_notification_queues-from_user` FOREIGN KEY (`from_user`) REFERENCES `users` (`user_id`),
  CONSTRAINT `fk-sms_notification_queues-resend_by` FOREIGN KEY (`resend_by`) REFERENCES `users` (`user_id`),
  CONSTRAINT `fk-sms_notification_queues-send_now_by` FOREIGN KEY (`send_now_by`) REFERENCES `users` (`user_id`),
  CONSTRAINT `fk-sms_notification_queues-to_user` FOREIGN KEY (`to_user`) REFERENCES `users` (`user_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8 COLLATE utf8_general_ci COMMENT='This table keeps all messages to send through SMS.';


