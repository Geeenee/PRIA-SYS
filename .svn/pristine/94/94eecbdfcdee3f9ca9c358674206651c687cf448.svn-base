CREATE TABLE `user_agreements` (
  `user_id` mediumint(8) unsigned NOT NULL AUTO_INCREMENT,
  `agreement_flag` tinyint(1) DEFAULT '0',
  `agreed_date` datetime DEFAULT NULL,
  PRIMARY KEY (`user_id`),
  KEY `user_id` (`user_id`),
  CONSTRAINT `user_id_agreement_ibfk_1` FOREIGN KEY (`user_id`) REFERENCES `users` (`user_id`) ON DELETE CASCADE ON UPDATE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=latin1;

