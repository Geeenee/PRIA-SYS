-- create backup table for users before updating the columns
CREATE TABLE tmp_users 
SELECT * FROM users;

-- Change the data type to varbinary(512)
ALTER TABLE users 
MODIFY username varbinary(512) DEFAULT NULL,
MODIFY fname varbinary(512) NOT NULL,
MODIFY lname varbinary(512) NOT NULL,
MODIFY mname varbinary(512) DEFAULT  NULL,
MODIFY ext_name varbinary(512) DEFAULT NULL,
MODIFY nickname varbinary(512) DEFAULT NULL,
MODIFY email varbinary(512) NOT NULL,
MODIFY job_title varbinary(512) DEFAULT NULL,
MODIFY contact_no varbinary(512) DEFAULT NULL,
MODIFY mobile_no varbinary(512) DEFAULT NULL;

ALTER TABLE user_history 
MODIFY username varbinary(512) DEFAULT NULL,
MODIFY fname varbinary(512) NOT NULL,
MODIFY lname varbinary(512) NOT NULL,
MODIFY mname varbinary(512) DEFAULT  NULL,
MODIFY ext_name varbinary(512) DEFAULT NULL,
MODIFY nickname varbinary(512) DEFAULT NULL,
MODIFY email varbinary(512) NOT NULL,
MODIFY job_title varbinary(512) DEFAULT NULL,
MODIFY contact_no varbinary(512) DEFAULT NULL,
MODIFY mobile_no varbinary(512) DEFAULT NULL;

-- Retrive the backup users data
UPDATE users A JOIN tmp_users B 
SET 
A.username = AES_ENCRYPT(B.username, UNHEX(SHA2("@$1@g@+3_$3cur1+y", 512))),
A.fname = AES_ENCRYPT(B.fname, UNHEX(SHA2("@$1@g@+3_$3cur1+y", 512))),
A.lname = AES_ENCRYPT(B.lname, UNHEX(SHA2("@$1@g@+3_$3cur1+y", 512))),
A.mname = AES_ENCRYPT(B.mname, UNHEX(SHA2("@$1@g@+3_$3cur1+y", 512))),
A.ext_name = AES_ENCRYPT(B.ext_name, UNHEX(SHA2("@$1@g@+3_$3cur1+y", 512))),
A.nickname = AES_ENCRYPT(B.nickname, UNHEX(SHA2("@$1@g@+3_$3cur1+y", 512))),
A.email = AES_ENCRYPT(B.email, UNHEX(SHA2("@$1@g@+3_$3cur1+y", 512))),
A.job_title = AES_ENCRYPT(B.job_title, UNHEX(SHA2("@$1@g@+3_$3cur1+y", 512))),
A.contact_no = AES_ENCRYPT(B.contact_no, UNHEX(SHA2("@$1@g@+3_$3cur1+y", 512))),
A.mobile_no = AES_ENCRYPT(B.mobile_no, UNHEX(SHA2("@$1@g@+3_$3cur1+y", 512)))
WHERE A.user_id = B.user_id;

UPDATE user_history A JOIN tmp_users B 
SET 
A.username = AES_ENCRYPT(B.username, UNHEX(SHA2("@$1@g@+3_$3cur1+y", 512))),
A.fname = AES_ENCRYPT(B.fname, UNHEX(SHA2("@$1@g@+3_$3cur1+y", 512))),
A.lname = AES_ENCRYPT(B.lname, UNHEX(SHA2("@$1@g@+3_$3cur1+y", 512))),
A.mname = AES_ENCRYPT(B.mname, UNHEX(SHA2("@$1@g@+3_$3cur1+y", 512))),
A.ext_name = AES_ENCRYPT(B.ext_name, UNHEX(SHA2("@$1@g@+3_$3cur1+y", 512))),
A.nickname = AES_ENCRYPT(B.nickname, UNHEX(SHA2("@$1@g@+3_$3cur1+y", 512))),
A.email = AES_ENCRYPT(B.email, UNHEX(SHA2("@$1@g@+3_$3cur1+y", 512))),
A.job_title = AES_ENCRYPT(B.job_title, UNHEX(SHA2("@$1@g@+3_$3cur1+y", 512))),
A.contact_no = AES_ENCRYPT(B.contact_no, UNHEX(SHA2("@$1@g@+3_$3cur1+y", 512))),
A.mobile_no = AES_ENCRYPT(B.mobile_no, UNHEX(SHA2("@$1@g@+3_$3cur1+y", 512)))
WHERE A.user_id = B.user_id;



-- TEST IF ENCRYPTION OR DECRYPTION IS WORKING
SELECT 
	CAST( AES_DECRYPT(username, UNHEX(SHA2("@$1@g@+3_$3cur1+y", 512))) AS CHAR) username ,
	CAST( AES_DECRYPT(fname, UNHEX(SHA2("@$1@g@+3_$3cur1+y", 512))) AS CHAR) fname ,
    CAST( AES_DECRYPT(lname, UNHEX(SHA2("@$1@g@+3_$3cur1+y", 512))) AS CHAR) lname 
FROM users;




