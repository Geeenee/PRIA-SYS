				FROM 	$this->user_roles a
				JOIN 	$this->roles b on a.role_code = b.role_code
				WHERE 	user_id = ?

";
			$val 		= array();
			$val[] 		= $user_id;

			$result 	= $this->query( $query, $val );
		}
		catch( PDOException $e )
		{
			throw $e;
		}

		return $result;
	}
	
