<div>
	<div class="font-lg m-b-md">Flock History Report</div>
	<div class="row b-t-n m-b-n">
		<div class="col l1 m2 s2 p-l-lg">
			<input type="checkbox" class="labelauty rounded" name="dr_chk[]" value="1" />
		</div>
		<div class="col l8 m7 s8">
			<div class="font-lg">Encode Flock History Report <div class="help-text font-sm m-t-xs">assigned to <span class="font-bold">Vendor</span></div></div>
		</div>
		<div class="col l3 m3 s2 right-align">
			<span class="badge rounded pink lighten-5">Pending</span>
		</div>
	</div>
	
	<!-- DATA ENTRY FORMS -->
	<div class="row b-t-n m-b-n">
		<div class="col l1 m2 s1"></div>
		<div class="col l11 m10 s11">
			<div class="panel-wrapper white">
				<div class="input-field">
					<div class="table-display">
						<div class="table-cell l3 m5 s5 right-align valign-middle p-r-md">			
							<label class="required">FHR Document No.</label>
						</div>

						<div class="table-cell l5 m6 s6 valign-middle">
							<input type="text" name="fhr_doc_no" id="fhr_doc_no" placeholder="Enter FHR Document No." />
						</div>
						<div class="table-cell l4 m1 s1 valign-middle"></div>
					</div>
				</div>
				<div class="input-field">
					<div class="table-display">
						<div class="table-cell l3 m5 s5 right-align valign-middle p-r-md">			
							<label>Date Submitted</label>
						</div>

						<div class="table-cell l3 m6 s6 valign-middle">
							<input type="text" class="datetimepicker" name="fhr_date_submitted" id="fhr_date_submitted" placeholder="Enter Date Submitted" />
						</div>
						<div class="table-cell l6 m1 s1 valign-middle"></div>
					</div>
				</div>
				<div class="input-field">
					<div class="table-display table-layout-fixed">
						<div class="table-cell l3 m5 s5 right-align valign-middle p-r-md">			
							<label>FHR Document File</label>
						</div>

						<div class="table-cell l9 m7 s7 valign-middle">
							<div class="file-wrapper pdf">
								<div class="type" data-file-type="pdf"></div>
								<div class="contents valign-top">
									<div class="filename truncate">fhr.pdf</div>
									uploaded March 11, 2019 3:15 by Juan dela Cruz. 97.2 KB
								</div>
								<div class="actions valign-middle right-align">
									<button type="button" id="view"><i class="material-icons valign-middle">search</i> View</button>
									<button type="button" id="view"><i class="material-icons valign-middle">cloud_download</i></button>
								</div>
							</div>
						</div>
					</div>
				</div>
				<div class="input-field">
					<div class="table-display">
						<div class="table-cell l3 m3 s3 right-align valign-middle p-r-md">			
							<label>Audit Scores</label>
							<div class="font-sm mute m-t-xs">(For display purposes only)</div>
						</div>

						<div class="table-cell l2 m3 s3 valign-middle p-r-sm">
							<input type="text" disabled name="transaction_date" id="transaction_date" placeholder="Enter Transaction Date"/>
							<div class="m-t-xs">Pre-Placement</div>
						</div>

						<div class="table-cell l2 m3 s3 valign-middle p-r-sm">
							<input type="text" readonly name="transaction_date" id="transaction_date" placeholder="Enter Transaction Date"/>
							<div class="m-t-xs">Brooding Audit</div>
						</div>

						<div class="table-cell l2 m3 s3 valign-middle p-r-sm">
							<input type="text" readonly name="transaction_date" id="transaction_date" placeholder="Enter Transaction Date"/>
							<div class="m-t-xs">Biosecurity Audit</div>
						</div>
						<div class="table-cell l3 m3 s3 valign-middle">
						</div>
					</div>
				</div>
				<div class="input-field">
					<div class="table-display">
						<div class="table-cell s3 right-align valign-middle p-r-md"></div>

						<div class="table-cell s9 valign-middle">
							<button type="submit" class="btn">Save</button>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
