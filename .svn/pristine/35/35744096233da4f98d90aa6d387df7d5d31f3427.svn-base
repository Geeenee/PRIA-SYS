ALTER TABLE `pria`.`contracts` 
ADD COLUMN `cn_recommendation_bh` TEXT NULL DEFAULT NULL AFTER `cn_recommendation`,
ADD COLUMN `cn_recommendation_rh` TEXT NULL DEFAULT NULL AFTER `cn_recommendation_bh`;

UPDATE `pria`.`param_document_types` SET `allowed_extensions`=CONCAT(`allowed_extensions`, ',xls,xlsx') WHERE `document_type_code`='DOC_PO';
UPDATE `pria`.`param_document_types` SET `allowed_extensions`=CONCAT(`allowed_extensions`, ',xls,xlsx') WHERE `document_type_code`='DOC_PR';

UPDATE `pria`.`pria_email_templates` SET `email_template_content`='<center>\r <table width=\'80%%\'>\r <tr>\r <td width=\'25%%\'><b>Reference Number:</b></td>\r <td width=\'75%%\'>%s</td>\r </tr>\r <tr>\r <td><b>Business Center:</b></td>\r <td>%s</td>\r </tr>\r <tr>\r <td><b>Official Store Name:</b></td>\r <td>%s</td>\r </tr>\r <tr>\r <td><b>Lessor:</b></td>\r <td>%s</td>\r </tr>\r <tr>\r <td valign=\'top\'><b>Main Attachment:</b></td>\r <td>%s</td>\r </tr>\r %s\r %s </table>\r </center>', `email_template_parameter`='reference_num, business_center, official_store_name, lessor, main_attachment, recommendations, remarks' WHERE `email_template_id`='16';

