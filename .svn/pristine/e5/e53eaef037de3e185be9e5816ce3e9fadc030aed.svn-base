    public function get_remaining_amount_by_po_num($po_num)
    {
        $stmt = array();
        $params = array($po_num);

        try {
            $query = "SELECT 
							IFNULL(remaining_amount, '0') as remaining_amount, po_amount 
						FROM 
							$this->tbl_purchase_orders 
						WHERE 
							po_num = ?";

            $stmt = $this->query($query, $params);
        } catch (PDOException $e) {
