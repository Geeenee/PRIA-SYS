    }

    public function get_tab_details($account_group_code)
    {
        $stmt = array();
        $params = array(AG_FORWARDERS, AG_INBOUND_NORMAL, AG_GOODS_BAVI, AG_GOODS_BFFI, AG_GOODS_MARINADES, AG_OUTBOUND, AG_SOA_BASED, ROOT_TRANSAC, APV_REF_TYPE_CODE_SOA, $account_group_code);

        try {
            $query = "SELECT 
							tab_module_code, core_workflow_id 
						FROM 
							$this->tbl_pria_tab_modules 
						WHERE 
							ag_code 
						IN 
							(?, ?, ?, ?, ?, ?, ?) 
						AND 
							root_module = ? 
						AND 
							transaction_tab = ? 
						AND ag_code = ?";

            $stmt = $this->query($query, $params);
        } catch (PDOException $e) {
            throw $e;
        }

        return $stmt;
    }

    public function check_if_vendor_role_exists($user_id)
    {
        $stmt         = array();

        $val = array($user_id, WORKFLOW_FOR_VENDOR);

        try {
            $query    =
                "SELECT 
                COUNT(1) as vendor_role_exist
            FROM  
                $this->tbl_user_roles 
            WHERE 
            	user_id = ? AND role_code = ?";

            $stmt     = $this->query($query, $val);
        } catch (PDOException $e) {
            throw $e;
        }

        return $stmt[0]['vendor_role_exist'];
    }

