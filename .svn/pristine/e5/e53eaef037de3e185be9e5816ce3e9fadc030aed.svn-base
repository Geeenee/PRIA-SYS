    public function get_soa_id_by_reference_id($document_type_code, $reference_num)
    {
        $stmt         = array();
        $val = array($reference_num);
        $query = '';

        try {
            switch ($document_type_code) {
                case DOC_TYPE_SOA:
                    $query    =
                        "SELECT 
			                soa_id
			            FROM  
			                $this->tbl_soa 
			            WHERE 
			            	soa_num = ?";
                    break;

                default:
                    break;
            }

            $stmt     = $this->query($query, $val);
        } catch (PDOException $e) {
            throw $e;
        }

        return $stmt;
    }

