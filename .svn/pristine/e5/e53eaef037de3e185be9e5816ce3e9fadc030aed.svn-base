    public function get_io_list($pageStart = 0, $pageEnd = 5)
    {
        $stmt         = array();
        $val = array(ORG_TYPE_BUSINESS_CENTER);

        try {
            $query    =
                "SELECT 
                a.io_id as reference_id, a.io_num as display_num, 
                b.vendor_name as display_name, 
                CONCAT('Business Center : ', d.name) as display_extra
            FROM  
                $this->tbl_internal_orders a 
            JOIN 
                $this->tbl_vendors b ON a.vendor_code = b.vendor_code
            JOIN 
                $this->tbl_sites c ON a.site_code = c.site_code
            JOIN 
                $this->tbl_business_center d ON c.org_code = d.org_code AND d.org_type_code = ? 
            ORDER BY a.io_id ASC";

            $stmt     = $this->query($query, $val);
        } catch (PDOException $e) {
            throw $e;
        }

        return $stmt;
    }

    public function get_all_vendors_dropdown_scoped($user_id)
    {
        $stmt = array();
        $params = array();

        try {
            $role_codes = $this->get_role_code_by_user_id($user_id);

            $length = 0;

            foreach ($role_codes as $value) {
                $length++;
                array_push($params, $value['role_code']);
            }

            $role_code_placeholder = $this->dynamic_placeholder($length);

            $scope = $this->get_scope($params, $role_code_placeholder)[0]['scope'];

            $is_system_wide = $scope == 'SCOPE_SYSTEM';

            $extended_statement = !$is_system_wide ? 'AND org_code IN(SELECT org_code FROM user_orgs WHERE user_id = ?)' : '';
            $val = !$is_system_wide ? array(ORG_TYPE_BUSINESS_CENTER, $user_id) : array(ORG_TYPE_BUSINESS_CENTER);

            $org_codes = "SELECT 
                            org_code 
                          FROM 
                            $this->tbl_business_center  
                          WHERE 
                            org_type_code = ? 
                          $extended_statement
                          ORDER BY name ASC";

            $query = "SELECT 
                        DISTINCT A.vendor_code, B.vendor_name
                      FROM 
                        $this->tbl_vendor_business_centers A
                      JOIN
                        $this->tbl_vendors B ON A.vendor_code = B.vendor_code
                      WHERE A.org_code IN($org_codes) ORDER BY B.vendor_name";

            $stmt     = $this->query($query, $val);
        } catch (PDOException $e) {
            throw $e;
        }

        return $stmt;
    }

    public function get_all_vendors_for_dropdown_by_org_code($org_code, $acc_group = "")
    {
        $stmt         = array();
        $params      = array($org_code);
        $extended_statement = "";
        if(!empty($acc_group)){
            $extended_statement .= " AND b.account_group_code = ?";
            array_push($params, $acc_group);
        }
        try {
            $query    =
                "SELECT 
                a.vendor_code, a.vendor_name
            FROM 
                $this->tbl_vendors a
            JOIN
                $this->tbl_vendor_account_group b 
	                ON a.vendor_code = b.vendor_code
            JOIN $this->tbl_vendor_business_centers AS c
                ON a.vendor_code = c.vendor_code AND c.org_code = ?
            WHERE 1 = 1 $extended_statement
            GROUP BY a.vendor_code ORDER BY a.vendor_name";
            $stmt     = $this->query($query, $params);
        } catch (PDOException $e) {
            throw $e;
        }

        return $stmt;
    }

    public function get_all_vendors_for_dropdown_by_org_code_with_all($org_code, $user_id, $vendor_code, $acc_group = '')
    {
        $stmt         = array();
        $params      = array();
        $add_statement  = "";
        $business_centers = $this->get_all_business_centers_for_dropdown($org_code, $user_id, $vendor_code, false, $acc_group);

        $length = 0;

        foreach ($business_centers as $value) {
            $length++;
            $json = json_decode(json_encode($value), true);
            array_push($params, $json['org_code']);
        }

        $org_code_placeholder = $this->dynamic_placeholder($length);
        if (!empty($acc_group)) {
            $add_statement .= "AND b.account_group_code = ? ";
            array_push($params, $acc_group);
        }
        if(!empty($org_code)){
            $add_statement .= "AND  c.org_code = ? ";
            array_push($params, $org_code);
        }
        try {
            // $query    =
            //     "SELECT 
            //     DISTINCT A.vendor_code, B.vendor_name
            // FROM 
            // 	$this->tbl_vendor_business_centers A
            // JOIN
            //     $this->tbl_vendors B ON A.vendor_code = B.vendor_code
            // WHERE A.org_code IN($org_code_placeholder) ORDER BY TRIM(B.vendor_name)";

            $query    =
                "SELECT 
                a.vendor_code, a.vendor_name
            FROM 
                $this->tbl_vendors a
            LEFT JOIN
                $this->tbl_vendor_account_group b 
	                ON a.vendor_code = b.vendor_code 
            LEFT JOIN $this->tbl_vendor_business_centers AS c
                ON a.vendor_code = c.vendor_code
            WHERE c.org_code IN($org_code_placeholder) 
            $add_statement
            GROUP BY  a.vendor_name  
            ORDER BY TRIM(a.vendor_name) ASC ";
            
            $stmt     = $this->query($query, $params);
        } catch (PDOException $e) {
            throw $e;
        }
        return $stmt;
    }

