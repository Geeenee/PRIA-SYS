    public function get_po_numbers_for_dropdown($vendor_code, $org_code)
    {
        $stmt = array();
        $params = $org_code == null ? array($vendor_code, YES_FLAG, $vendor_code, PO_RELEASED) : array($vendor_code, $org_code, PO_RELEASED);

        $condition = $org_code == null ? "A.po_id 
					NOT IN 
						(SELECT
							A.po_id
						FROM
							$this->tbl_purchase_orders A
						JOIN 
							$this->tbl_delivery_goods_reference B ON A.po_id = B.po_id
						JOIN
							$this->tbl_delivery_goods_receipt C ON B.dr_gr_id = C.dr_gr_id
						WHERE
							A.vendor_code = ? AND C.last_dr_flag = ?)
						AND
							A.vendor_code = ?" : "A.vendor_code = ? AND A.org_code = ?";

        try {
            $query = "SELECT
						A.po_num, A.po_id
					FROM
						$this->tbl_purchase_orders A
					WHERE 
						$condition
					AND 
						A.po_status_code = ?";

            $stmt = $this->query($query, $params);
        } catch (PDOException $e) {
            throw $e;
        }

        return $stmt;
    }

    public function get_all_account_groups_for_dropdown($vendor_code, $is_soa, $user_id)
    {
        $stmt         = array();
        if ($vendor_code == null) {
            $params = array($user_id, MODULE_PORTAL_TRANSACTIONS, 'PORTAL_GOODS', 'PORTAL_TRUCKERS');
        } elseif ($is_soa != null) {
            $params = array($vendor_code, AG_SOA_BASED, AG_GOODS_MARINADES, AG_GOODS_BAVI, AG_GOODS_BFFI, AG_INBOUND_NORMAL, AG_OUTBOUND, AG_FORWARDERS);
        } else {
            $params = array(YES_FLAG, $vendor_code);
        }

        try {
            if ($vendor_code == null) {
                $query = "SELECT
                            d.account_group_code, e.account_group_name
                        FROM
                            pria_core.user_roles a
                        JOIN
                            pria_core.module_action_roles b
                        ON
                            a.role_code = b.role_code
                        JOIN
                            pria_core.module_actions c
                        ON
                            b.module_action_id = c.module_action_id
                        JOIN
                            param_account_group_modules d
                        ON
                            c.module_code = d.module_code
                        JOIN
                            param_account_groups e
                        ON
                            d.account_group_code = e.account_group_code
                        WHERE
                            a.user_id = ?
                        AND
                            c.module_code != ? 
                        AND 
                            d.parent_module_code NOT IN (?, ?)
                        GROUP BY
                            d.account_group_code,c.module_code
                        ORDER BY 
                            d.account_group_code";
            } elseif ($is_soa != null) {
                $query = "SELECT 
                            A.account_group_code,
                            A.account_group_name
                        FROM 
                            $this->tbl_account_groups A
			            LEFT JOIN
                            $this->tbl_vendor_account_group B 
			            ON 
				            A.account_group_code = B.account_group_code
                        WHERE 
				            B.vendor_code = ?
			            AND 
				            A.account_group_code IN(?, ?, ?, ?, ?, ?, ?)
			            GROUP BY
				            account_group_code 
			            ORDER BY 
				            account_group_code ASC";
            } else {
                $query = "SELECT 
                            A.account_group_code, A.account_group_name
                        FROM 
            	            $this->tbl_account_groups A
			            LEFT JOIN
            	            $this->tbl_vendor_account_group B 
			            ON 
				            A.account_group_code = B.account_group_code
                        WHERE 
                            dashboard_flag = ? 
			            AND 
				            B.vendor_code = ?
                        ORDER BY 
				            account_group_code ASC";
            }
            
            $stmt     = $this->query($query, $params);
        } catch (PDOException $e) {
            throw $e;
        }

        return $stmt;
    }

