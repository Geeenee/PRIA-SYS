    public function get_all_ref_num_by_org_code_vendor_code($where)
    {
        $stmt         = array();
        $val = array();
        $extended_statement = '';

        $org_code = $where['org_code'];
        $user_id = $where['user_id'];
        $vendor_code = $where['vendor_code'];
        $ag_code = $where['ag_code'];
        $core_workflow_id = $where['core_workflow_id'];
        $selected_tab = $where['selected_tab'];

        $tbl_joins = "";
        $group_by = "";
        $order_by = "";
        $fields = "";
        if (!empty($selected_tab) && $selected_tab == 'PR') {
            array_push($val, $core_workflow_id);
            if (in_array($ag_code, ['GMR', 'GBV', 'GBF'])) {
                $tbl_joins .= "
                $this->tbl_pria_workflows a
                LEFT JOIN $this->tbl_purchase_requisitions b 
                ON b.pr_id = a.reference_id
                AND b.account_group_code = a.account_group_code
                AND a.core_workflow_id = ?
                                    JOIN $this->tbl_purchase_request_cost_centers D 
                ON b.pr_id = D.pr_id
                JOIN
                    $this->tbl_sites E
                    ON D.cost_center_code = E.cost_center_code
                JOIN 
                    $this->tbl_organizations F 
                    ON E.org_code = F.org_code
                LEFT JOIN $this->tbl_param_purchasing_group C 
                    ON b.purchasing_group_code = C.purchasing_group_code
                ";
                $fields .= "DISTINCT b.pr_num AS reference_num ";
                $group_by .= "GROUP BY b.pr_id";
                $order_by .= "ORDER BY b.pr_id DESC";
            } else {
                $tbl_joins .= "
                        $this->tbl_pria_workflows a
                        LEFT JOIN $this->tbl_purchase_requisitions b 
                        ON b.pr_id = a.reference_id
                        AND b.account_group_code = a.account_group_code
                        AND a.core_workflow_id = ?
                                             JOIN $this->tbl_boq_pr D 
                            ON b.pr_id = D.pr_id
                        LEFT JOIN $this->tbl_boq G
                            ON D.boq_id = G.boq_id
                        LEFT JOIN
                            $this->tbl_sites E
                            ON G.site_id = E.site_id
                        LEFT JOIN 
                            $this->tbl_organizations F 
                            ON E.org_code = F.org_code
                        ";
                $fields .= "DISTINCT b.pr_num AS reference_num ";
                $group_by .= "GROUP BY b.pr_id";
                $order_by .= "ORDER BY b.pr_id DESC";
            }
        } else {
            if (in_array($ag_code, ['GBV', 'GBF', 'GMR'])) {
                if( $selected_tab == 'SOA'){
                    $tbl_joins .= "
                        $this->tbl_soa e
                    LEFT JOIN 
                        $this->tbl_vendors b ON e.vendor_code = b.vendor_code
                    LEFT JOIN 
                        $this->tbl_pria_workflows a ON e.soa_id = a.reference_id
                    AND 
                        e.account_group_code = a.account_group_code
                    AND 
                        a.core_workflow_id IN (16)
                                            JOIN pria_references prf ON e.soa_id = prf.soa_id
                        JOIN 
                            $this->tbl_purchase_orders po ON prf.po_id = po.po_id
                        JOIN
                            pria_references prf2 ON po.po_id = prf2.po_id AND prf2.pr_id IS NOT NULL
                        JOIN
                            $this->tbl_purchase_request_cost_centers prcc ON prf2.pr_id = prcc.pr_id
                        JOIN
                        $this->tbl_sites s ON prcc.cost_center_code = s.cost_center_code
                    JOIN 
                        $this->tbl_organizations D ON s.org_code = D.org_code  
                    ";

                    $fields .= "DISTINCT e.soa_num AS reference_num";
                    $group_by .= "GROUP BY e.soa_id";
                    $order_by .= "ORDER BY e.soa_id DESC";
                }else{
                    $tbl_joins .= "
                        $this->tbl_pria_workflows a
                        JOIN $this->tbl_purchase_orders b
                            ON a.reference_id = b.po_id 
                        JOIN pria_references c
                            ON  b.po_id = c.po_id
                        JOIN $this->tbl_purchase_requisitions d
                            ON c.pr_id = d.pr_id AND d.account_group_code = a.account_group_code
                        JOIN $this->tbl_purchase_request_cost_centers e
                            ON d.pr_id = e.pr_id
                        JOIN $this->tbl_sites f
                            ON e.cost_center_code = f.cost_center_code
                        JOIN $this->tbl_organizations g
                            ON f.org_code = g.org_code
                    ";

                    $fields .= "DISTINCT a.reference_num ";
                    $group_by .= "GROUP BY b.po_id";
                    $order_by .= "ORDER BY b.po_id DESC";
                }
            } else if (in_array($ag_code, ['CTR'])  && $selected_tab == 'PO') {
                $tbl_joins .= "
                        $this->tbl_purchase_orders z
					JOIN
						pria_references F ON z.po_id = F.po_id
					JOIN
                    $this->tbl_purchase_requisitions B ON F.pr_id = B.pr_id
										JOIN $this->tbl_boq_pr b1 ON B.pr_id = b1.pr_id
					JOIN $this->tbl_boq b2 ON b1.boq_id = b2.boq_id
					JOIN $this->tbl_sites b3 ON b2.site_id = b3.site_id
					JOIN $this->tbl_organizations X ON b3.org_code = X.org_code
					LEFT JOIN
                        $this->tbl_vendors C ON z.vendor_code = C.vendor_code
					LEFT JOIN
                        $this->tbl_pria_workflows a ON z.po_id = a.reference_id
						AND B.account_group_code = a.account_group_code
        ";

                $fields .= "DISTINCT z.po_num  as reference_num ";
                $group_by .= "GROUP BY z.po_id";
                $order_by .= "ORDER BY z.po_id DESC";
            } else {
                $tbl_joins .= "
                $this->tbl_pria_workflows a";
                $fields .= "DISTINCT a.reference_num ";
                $group_by .= "GROUP BY reference_num";
                $order_by .= "ORDER BY a.pria_workflow_id DESC";
            }
        }

        if (!empty($org_code)) {
            array_push($val, $org_code);
            if ($selected_tab == 'PR') {
                $extended_statement .= " AND F.org_code IN(?)";
            } else {
                $extended_statement .= " AND a.org_code IN(?)";
            }
        } else {
            if ($selected_tab != 'PR') {
                $user_org_code = $this->get_org_code_by_user_id($user_id);
                $user_vendor_code = $this->get_vendor_code_by_user_id($user_id);
                $business_centers = $this->get_all_business_centers_for_dropdown($user_org_code, $user_id, $user_vendor_code, false, $ag_code, $core_workflow_id);

                $org_codes = array_map(function ($bc) {
                    return $bc['org_code'];
                }, $business_centers);
                $bc_placeholder = $this->dynamic_placeholder(count($org_codes));
                $extended_statement .= " AND a.org_code IN($bc_placeholder)";
                $val = array_merge($val, $org_codes);
            }
        }

        if (!empty($vendor_code)) {
            array_push($val, $vendor_code);
            $extended_statement .= " AND a.vendor_code IN(?)";
        }

        if (!empty($ag_code)) {
            array_push($val, $ag_code);
            $extended_statement .= " AND a.account_group_code = ?";
        }
        if (!empty($core_workflow_id) &&  $selected_tab != 'PR') {
            array_push($val, $core_workflow_id);
            $extended_statement .= " AND a.core_workflow_id = ?";
        }


        try {
            $query    =
                "SELECT 
                $fields 
            FROM 
            	
            $tbl_joins
			WHERE 1=1 $extended_statement
            $group_by
            $order_by";
            // var_dump('<pre>');
            // var_dump($val);
            // var_dump($query);
            $stmt     = $this->query($query, $val);
        } catch (PDOException $e) {
            throw $e;
        }

        return $stmt;
    }

    public function get_all_transaction_tabs_by_ag_code($where)
    {
        $stmt         = array();
        $val = array(MODULE_PORTAL_TRANSACTIONS, TRANS_TAB_DR, TRANS_TAB_CONTRACTS, $where['ag_code']);

        try {
            $query    =
                "SELECT 
                core_workflow_id, transaction_tab 
            FROM 
                $this->tbl_pria_tab_modules 
            WHERE 
                root_module = ? 
            AND 
                transaction_tab IS NOT NULL
            AND 
                transaction_tab NOT IN (?, ?)
            AND ag_code = ? ORDER BY transaction_tab";

            $stmt     = $this->query($query, $val);
        } catch (PDOException $e) {
            throw $e;
        }

        return $stmt;
    }

    public function get_all_workflow_stages($where)
    {
        $stmt         = array();
        $val = array($where['ag_code']);
        $extended_statement = '';

        $org_code = $where['org_code'];
        $vendor_code = $where['vendor_code'];

        if (!empty($org_code)) {
            $extended_statement .= ' AND A.org_code = ?';
            array_push($val, $org_code);
        }

        if (!empty($vendor_code)) {
            $extended_statement .= ' AND IFNULL(I.confirmed_contractor, IFNULL(H.recommended_vendor_code, D.vendor_code)) = ?';
            array_push($val, $vendor_code);
        }

        if (!empty($core_workflow_id)) {
            $extended_statement .= ' AND A.core_workflow_id = ?';
            array_push($val, $core_workflow_id);
        }

        $join_tbl = '';
        if (!empty($where['selected_tab']) && $where['selected_tab'] == 'PR') {
            $join_tbl = "JOIN $this->tbl_purchase_requisitions E 
                ON E.pr_id = A.reference_id";
            $extended_statement .= ' AND E.pr_num = ?';
            array_push($val, $where['ref_num']);
        } else {
            $extended_statement .= ' AND A.reference_num = ?';
            array_push($val, $where['ref_num']);
        }


        try {
            $query    =
                "SELECT 
				B.pria_stage_id,
				B.stage_name,
				IFNULL(D.vendor_name, '') as vendor_name
			FROM 
				$this->tbl_pria_workflows A 
                $join_tbl
			LEFT JOIN 
				$this->tbl_pria_workflow_stages B ON A.pria_workflow_id = B.pria_workflow_id
			LEFT JOIN 
				$this->tbl_pria_tasks C ON B.pria_stage_id = C.pria_stage_id 
			LEFT JOIN 
				$this->tbl_vendors D ON A.workflow_for_id = D.vendor_code 
            LEFT JOIN
                $this->tbl_boq H ON A.reference_num = H.boq_code
			LEFT JOIN
                $this->tbl_boq_asset_codes I ON H.boq_id = I.boq_id
			WHERE 
				A.account_group_code = ? 
            $extended_statement
			GROUP BY 
				B.pria_stage_id 
			ORDER BY 
			    A.pria_workflow_id, ABS(B.sequence_no) ASC";
            $stmt     = $this->query($query, $val);
        } catch (PDOException $e) {
            throw $e;
        }

        return $stmt;
    }

    public function get_finance_recipients($org_code)
    {
        $stmt = array();

        try {
            $query   = <<<EOS
                SELECT
                    A.user_id,
                    CONCAT(
                        AGDEC(A.fname), ' ',
                        IFNULL(AGDEC(A.mname),''), ' ',
                        IFNULL(AGDEC(A.lname),''),' ',
                        IFNULL(AGDEC(A.ext_name),'')
                    ) as fullname
                                        
                FROM $this->tbl_core_users A
                
                JOIN $this->tbl_core_user_roles B ON A.user_id = B.user_id

                JOIN $this->tbl_core_roles C ON B.role_code = C.role_code

                JOIN $this->tbl_user_orgs  D ON A.user_id = D.user_id
                
                WHERE C.finance_flag = ?

                AND   D.org_code     = ?

                GROUP BY A.user_id
                ORDER BY AGDEC(A.fname)
EOS;
            //kevin
            $stmt = $this->query($query, array(FINANCE_YES_FLAG, $org_code), TRUE, TRUE);
        } catch (PDOException $e) {
            throw $e;
        }

        return $stmt;
    }

    public function get_all_workflow_stage_tasks($where)
    {
        $stmt         = array();
        $join_tbl = "";
        $org_con = "";
        $extended_statement = '';
        $val = array($where['ag_code'], $where['pria_stage_id']);
        if (!empty($where['selected_tab']) && $where['selected_tab'] == 'PR') {
            $join_tbl = "
            JOIN $this->tbl_purchase_requisitions I 
                ON I.pr_id = A.reference_id
            LEFT JOIN $this->tbl_purchase_request_cost_centers L 
                ON I.pr_id = L.pr_id
                LEFT JOIN
                    $this->tbl_sites M
                    ON L.cost_center_code = M.cost_center_code   
                ";
            $org_con .= "ON M.org_code = J.org_code";
            $extended_statement .= "AND I.pr_num = ?";
            array_push($val, $where['ref_num']);
        } else {
            $extended_statement .= ' AND A.reference_num = ?';
            array_push($val, $where['ref_num']);
            $org_con .= "ON A.org_code = J.org_code";
        }
        try {
            $query    =
                "SELECT 
                K.account_group_name,
				IFNULL(GROUP_CONCAT(DISTINCT J.name), 'N/A') business_center_name,
				C.pria_task_id,
				B.stage_name,
				C.task_name,
			    GROUP_CONCAT(E.role_code SEPARATOR ', ') role_code,
			    GROUP_CONCAT(F.role_name SEPARATOR ', ') role_name,
                IFNULL(AGDEC(C.actor_name), '') as actor_name,
			    IFNULL(G.vendor_name, '') as vendor_name,
				IF(C.returned_flag = 'Y' AND C.task_status_id = 2, 'Resubmitted', IFNULL(D.action_name, 'Pending')) as task_status_name, 
                A.reference_id as reference, 
                C.task_status_id, A.org_code, 
                A.reference_num, 
                C.core_workflow_task_id, 
                IFNULL(DATE_FORMAT(C.actual_end_date, '%m/%d/%Y'),'N/A') as actual_end_date
			FROM 
				$this->tbl_pria_workflows A 
            $join_tbl
			LEFT JOIN 
				$this->tbl_pria_workflow_stages B ON A.pria_workflow_id = B.pria_workflow_id
			LEFT JOIN 
				$this->tbl_pria_tasks C ON B.pria_stage_id = C.pria_stage_id 
			LEFT JOIN 
				$this->tbl_pria_task_actions D ON C.pria_task_id = D.pria_task_id AND C.task_status_id = D.pria_task_action_id 
			LEFT JOIN 
				$this->tbl_pria_task_roles E ON C.pria_task_id = E.pria_task_id 
			LEFT JOIN 
				$this->tbl_core_roles F ON E.role_code = F.role_code 
			LEFT JOIN 
				$this->tbl_vendors G ON A.workflow_for_id = G.vendor_code
            LEFT JOIN
                $this->tbl_organizations J ON A.org_code = J.org_code
			LEFT JOIN
                $this->tbl_account_groups K ON A.account_group_code = K.account_group_code
			WHERE 
				A.account_group_code = ? AND B.pria_stage_id = ?
                $extended_statement
            GROUP BY
				pria_task_id
			ORDER BY 
				C.sequence_no";
               
            $stmt     = $this->query($query, $val);
        } catch (PDOException $e) {
            throw $e;
        }

        return $stmt;
    }

    public function get_bc_name_vs2($where)
    {
        $val = array();
        try {
            $extended_statement = "";
            if($where['core_workflow_id']){
                array_push($val, $where['core_workflow_id']);
                $extended_statement .= " AND D.core_workflow_id = ?";
            }
            if($where['ag_code']){
                array_push($val, $where['ag_code']);
                $extended_statement .= " AND B.account_group_code = ?";
            }
            if($where['ref_num']){
                array_push($val, $where['ref_num']);
                $extended_statement .= " AND D.reference_num = ?";
            }
            $query = "
                SELECT 
                    A.po_id AS reference_id, 
                    A.po_num AS display_num, 
                    CONCAT(GROUP_CONCAT(DISTINCT C1.purchasing_group_name SEPARATOR ', '), ' : ', C.vendor_name) AS display_name,
                    GROUP_CONCAT(DISTINCT B.pr_num SEPARATOR ', ') as pr_num,
                    GROUP_CONCAT(DISTINCT X.name SEPARATOR ', ') as bc_name,
                    IF(B.account_group_code = 'CTR', CONCAT('Project Type : ', IF(A.additional_flag = 1, 'Additional Works', 'New Project'), ', '), '') as proj_type,
                    IF(A.po_date IS NOT NULL, DATE_FORMAT(A.po_date, '%b %d, %Y'), 'N/A') as po_date,
                    D.pria_workflow_id, 
                    X.org_code, 
                    D.vendor_code
                FROM
                    $this->tbl_purchase_orders A
                JOIN
                    $this->tbl_delivery_goods_reference F ON A.po_id = F.po_id
                JOIN
                    $this->tbl_purchase_requisitions B ON F.pr_id = B.pr_id
                                    JOIN purchase_request_cost_centers Z ON B.pr_id = Z.pr_id
                JOIN $this->tbl_sites Y ON Z.cost_center_code = Y.cost_center_code
                JOIN $this->tbl_organizations X ON Y.org_code = X.org_code
                LEFT JOIN $this->tbl_param_purchasing_group C1 ON B.purchasing_group_code = C1.purchasing_group_code
                LEFT JOIN
                    $this->tbl_vendors C ON A.vendor_code = C.vendor_code
                LEFT JOIN
                    $this->tbl_pria_workflows D ON A.po_id = D.reference_id
                    AND B.account_group_code = D.account_group_code
                    WHERE 1= 1 
                    $extended_statement
                GROUP BY A.po_id
                ORDER BY A.po_id DESC
            ";
            // var_dump('<pre>');
            // var_dump($query, $val);die();
           return $this->query($query, $val);
        } catch (PDOException $e) {
            throw $e;
        }
    
    }

    public function get_all_notifications($notify_users, $show_reminders, $limit, $is_count, $show_all)
    {
        $stmt  = array();
        $val = $show_all ? array($notify_users) : array($notify_users, $show_reminders);

        $fields = !$is_count ? 'notification_id, notification_icon, notification as notification_msg,
        UNIX_TIMESTAMP(notification_date) as notification_date' : 'count(notification_id) as notification_count';

        $extended_statement = !$show_all ? 'AND reminder_flag = ?' : '';

        $limit_keyword = $limit != null ? 'LIMIT ' . $limit : '';

        try {
            $query    =
                "SELECT 
            	$fields
            FROM 
            	$this->tbl_core_notifications 
            WHERE
            	notify_users = ?
            $extended_statement
			ORDER BY 
                notification_id DESC
            $limit_keyword";

            $stmt     = $this->query($query, $val);
        } catch (PDOException $e) {
            throw $e;
        }

        return $stmt;
    }

    public function get_all_apv_status_dropdown()
    {
        $stmt         = array();

        try {
            $query    =
                "SELECT 
            	apv_status_id, apv_status_name
            FROM 
            	$this->tbl_param_apv_status 
			ORDER BY 
                apv_status_name ASC";
            $stmt     = $this->query($query);
        } catch (PDOException $e) {
            throw $e;
        }

        return $stmt;
    }

    public function get_allowed_extensions($where)
    {
        $stmt = array();
        $params = array($where['document_type_code']);

        try {
            $query = "SELECT
							allowed_extensions, file_bytes
						FROM 
							$this->tbl_document_types
						WHERE
							document_type_code = ?";
            $stmt = $this->query($query, $params);
        } catch (PDOException $e) {
            throw $e;
        }

        return $stmt;
    }
}
