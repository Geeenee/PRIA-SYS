    }

    public function get_workflow_id_by_po_id($po_id)
    {
        $stmt         = array();

        $val = array($po_id, CORE_WORKFLOW_PURCHASE_ORDER_W_APPROVAL, CORE_WORKFLOW_PURCHASE_ORDER_WO_APPROVAL);

        try {
            $query    =
                "SELECT 
            	B.pria_workflow_id,
				B.core_workflow_id,
				C.pr_id,
				C.account_group_code
            FROM 
            	$this->tbl_purchase_orders A 
            JOIN 
            	$this->tbl_pria_workflows B 
				ON 
            	A.po_id = B.reference_id 
			JOIN 
				$this->tbl_purchase_requisitions C
				ON 
				A.pr_id = C.pr_id
            WHERE 
            	A.po_id = ? 
            AND B.core_workflow_id 
            	IN 
            (?, ?)";

            $stmt     = $this->query($query, $val);
        } catch (PDOException $e) {
            throw $e;
        }

        return $stmt;
    }

    public function get_all_assigned_task($where)
    {
        $stmt         = array();

        $val = array($where['user_id']);

        $extended_statement = "";

        if (!empty($where['account_group_name'])) {
            $extended_statement .= " AND F.account_group_name = '" . $where['account_group_name'] . "'";
        }

        if (!empty($where['task_status'])) {
            if ($where['task_status'] == 'Pending') {
                $extended_statement .= " AND E.action_name IS NULL";
            } 
            else if($where['task_status'] == 'Resubmitted'){
                 $extended_statement .= " AND E.action_name = 'Submitted' AND A.returned_flag = 'Y'";
            }
            else {
                $extended_statement .= " AND IFNULL(E.action_name, 'Pending') = '" . $where['task_status'] . "'";
            }
        }
        // else{
        //     $extended_statement .= " AND IFNULL(E.action_name, 'Pending') IN ('Pending', 'Ongoing', 'Returned')";
        // }

        if (!empty($where['task_name'])) {
            $extended_statement .= " AND A.task_name = '" . $where['task_name'] . "'";
        }

        if (!empty($where['org_code'])) {
            array_push($val, $where['org_code']);
            $extended_statement .= " AND C.org_code = ?";
        } else {
            if (!empty($where['user_org_code']) && !empty($where['user_vendor_code'])) {
                $business_centers = $this->get_all_business_centers_for_dropdown($where['user_org_code'], $where['user_id'], $where['user_vendor_code']);

                $length = 0;

                foreach ($business_centers as $value) {
                    $length++;
                    $json = json_decode(json_encode($value), true);
                    array_push($val, $json['org_code']);
                }

                $org_code_placeholder = $this->dynamic_placeholder($length);
                $extended_statement .= " AND C.org_code IN($org_code_placeholder)";
            }
        }

        if (!empty($where['vendor_code'])) {
            array_push($val, $where['vendor_code']);
            $extended_statement .= " AND C.vendor_code = ?";
        }
        
        $extended_statement .=  "AND C.status_code != 'COMPLETED'";


        try {
            $query    =
                "
                SELECT 
                IFNULL(H.name, '') business_center_name, IFNULL(I.vendor_name, '') vendor_name,
                A.core_workflow_task_id, C.reference_num, A.pria_task_id, A.pria_stage_id, A.task_name, 
                C.status_code,
                IFNULL(DATE_FORMAT(A.start_date, '%m/%d/%Y'), '') as start_date,
                IFNULL(DATE_FORMAT(A.end_date, '%m/%d/%Y'), '') as end_date, 
                A.user_id, IFNULL(AGDEC(A.actor_name), '') as actor_name, 
				IF(A.returned_flag = 'Y' AND A.task_status_id = 2, 'Resubmitted', IFNULL(E.action_name, 'Pending')) as task_status_name, 
				C.account_group_code, F.account_group_name, C.org_code, C.reference_id as reference, A.task_status_id,
                A.returned_flag,
                J.role_name,
                C.core_workflow_id,
                IF(A.created_by = ".$where['user_id'].", 'YES', 'NO') as created_by_user
            FROM 
            	$this->tbl_pria_tasks A
			JOIN 
				$this->tbl_pria_workflow_stages B ON A.pria_stage_id = B.pria_stage_id 
			JOIN 
				$this->tbl_pria_workflows C ON B.pria_workflow_id = C.pria_workflow_id 
			LEFT JOIN 
				$this->tbl_pria_task_actions E ON A.pria_task_id = E.pria_task_id AND A.task_status_id = E.pria_task_action_id 
			JOIN 
				$this->tbl_account_groups F ON C.account_group_code = F.account_group_code 
			JOIN 
				$this->tbl_pria_task_roles G ON A.pria_task_id = G.pria_task_id
            LEFT JOIN
                $this->tbl_organizations H ON C.org_code = H.org_code
			LEFT JOIN
                $this->tbl_vendors I ON C.vendor_code = I.vendor_code
            LEFT JOIN 
				$this->tbl_core_roles J ON G.role_code = J.role_code
			WHERE  A.user_id = ? " . $extended_statement . " 

			ORDER BY A.pria_task_id DESC
            ";
            // var_dump('<pre>');
            // var_dump($query, $val);die();
            $stmt     = $this->query($query, $val);
        } catch (PDOException $e) {
            throw $e;
        }
        return $stmt;
    }

    public function get_soa_by_soa_id($pria_task_id, $soa_id)
    {
        $stmt = array();
        $val = array($pria_task_id, $soa_id);

        try {
            $query = "SELECT 
						A.account_group_code,
						B.account_group_name, 
						A.soa_date, 
						A.soa_num, 
						C.name, 
						DATE_FORMAT(A.submission_date, '%m/%d/%Y') AS date_submitted, 
						A.soa_amount, 
						DATE_FORMAT(A.date_from, '%m/%d/%Y') AS date_from, 
						DATE_FORMAT(A.date_to, '%m/%d/%Y') AS date_to, 
						IFNULL(D.file_name, '') AS file_name, 
						D.sys_file_name, 
						D.created_date, 
						CONCAT(AGDEC(E.fname),' ',IFNULL(AGDEC(E.mname),''),IFNULL(AGDEC(E.lname),'')) AS created_by_fullname,
                        CONCAT(AGDEC(F.fname),' ',IFNULL(AGDEC(F.mname),''),IFNULL(AGDEC(F.lname),'')) AS finance_in_charge,
                        AGDEC(F.email) as finance_in_charge_email,
                        IFNULL(A.doc_recipient, '') AS soa_doc_recipient,
                        G.returned_flag,
                        IFNULL(AGDEC(G.actor_name), '') actor_name,
                        I.role_name,
                        G.sequence_no,
                        A.recipient_id,
                        IF(A.created_by = G.created_by, 'YES', 'NO') as created_by_user
					FROM 
						$this->tbl_soa A
					LEFT JOIN 
						$this->tbl_account_groups B ON A.account_group_code = B.account_group_code
					LEFT JOIN 
						$this->tbl_business_center C ON A.org_code = C.org_code
					LEFT JOIN 
						$this->tbl_documents D ON A.soa_id = D.reference AND D.document_type_code = 'DOC_SOA'
					LEFT JOIN 
						$this->tbl_core_users E ON E.user_id = D.created_by
                    LEFT JOIN 
						$this->tbl_core_users F ON F.user_id = A.recipient_id
                    LEFT JOIN
                        $this->tbl_pria_tasks G ON ? = G.pria_task_id
                    LEFT JOIN 
                        $this->tbl_pria_task_roles H ON G.pria_task_id = H.pria_task_id
                    LEFT JOIN 
                        $this->tbl_core_roles I ON H.role_code = I.role_code
					WHERE 
						soa_id = ?";
            $stmt = $this->query($query, $val);
        } catch (PDOException $e) {
            throw $e;
        }

        return $stmt;
    }

    public function get_apv_num_or_cv_num($is_apv_num, $account_group_code, $org_code, $vendor_code, $user_org_code, $apv_num, $user_id, $apv_status)
    {
        $stmt = array();
        $params = array();
        $query = '';
        $account_group_code_placeholder = '';
        $org_code_placeholder = '';
        $and_apv_num = '';
        $extended_statement = "";
        if (empty($account_group_code)) {
            $account_groups = $this->get_all_account_groups_for_dropdown($vendor_code, null, $user_id);

            $length = 0;

            foreach ($account_groups as $value) {
                $length++;
                $json = json_decode(json_encode($value), true);
                array_push($params, $json['account_group_code']);
            }

            $account_group_code_placeholder = $this->dynamic_placeholder($length);
        } else {
            array_push($params, $account_group_code);
            $account_group_code_placeholder = '?';
        }
       
        if (empty($org_code)) {
            $user_org_code = $this->get_org_code_by_user_id($user_id);
            $business_centers = $this->get_all_business_centers_for_dropdown($user_org_code, $user_id, $vendor_code);

            $length = 0;

            foreach ($business_centers as $value) {
                $length++;
                $json = json_decode(json_encode($value), true);
                array_push($params, $json['org_code']);
            }

            $org_code_placeholder = $this->dynamic_placeholder($length);
        } else {
            array_push($params, $org_code);
            $org_code_placeholder = '?';
        }

        if ($apv_num != null) {
            $and_apv_num = 'AND A.apv_num = ?';
            array_push($params, $apv_num);
        }

        if(!empty($apv_status)){
            $apv_data = $this->get_apv_status_data($apv_status);

            if(!is_bool($apv_data)){
                $extended_statement .= "AND A.apv_status_code = ?";
                array_push($params, $apv_data->apv_status_id);
            }

        }

        $column_name = $is_apv_num ? 'A.apv_num' : 'A.cv_num';

        try {
            $query = "SELECT DISTINCT 
							$column_name 
						FROM 
							$this->tbl_payment_apvs A 
						LEFT JOIN 
							$this->tbl_payments B 
						ON 
							A.payment_id = B.payment_id
						WHERE 
							($column_name IS NOT NULL 
								AND 
								$column_name != '')
						AND 
							B.account_group_code IN($account_group_code_placeholder) 
						AND 
							B.org_code IN($org_code_placeholder)
                        $and_apv_num
                        $extended_statement
                        ORDER BY $column_name";

            $stmt = $this->query($query, $params);
        } catch (PDOException $e) {
            throw $e;
        }

        return $stmt;
    }

    public function get_specific_task($pria_task_id, $type)
    {
        $stmt         = array();
        $query = '';
        $val = array();

        try {
            switch ($type) {
                case TASK_TYPE_ENCODE_FHR:

                    array_push($val, DOC_TYPE_FHR);

                    $query    =
                        "SELECT 
			                IFNULL(D.task_status_id, 0) as task_status_id, B.reference_num, D.pria_task_id, K.role_code, L.role_name, D.task_name, A.stage_name, B.account_group_code,
			                IFNULL(IF(D.returned_flag = 'Y' AND D.task_status_id IN(2,7),'Resubmitted',H.action_name), 'Pending') as task_status_name,
							IFNULL(G.fhr_document_num, '') as fhr_document_num, 
							IFNULL(DATE_FORMAT(G.fhr_submit_date, '%m/%d/%Y'), '') as fhr_submit_date,
							F.document_type_code, 
							CONCAT(AGDEC(I.fname),' ',IFNULL(AGDEC(I.mname),''),IFNULL(AGDEC(I.lname),'')) as created_by,
							CONCAT(AGDEC(J.fname),' ',IFNULL(AGDEC(J.mname),''),IFNULL(AGDEC(J.lname),'')) as modified_by,
							F.file_name, F.sys_file_name, F.version, F.created_date, F.modified_date,
                            D.returned_flag,
                            IFNULL(AGDEC(D.actor_name), '') as actor_name
			            FROM 
			            	$this->tbl_pria_workflow_stages A 
						LEFT JOIN 
							$this->tbl_pria_workflows B ON A.pria_workflow_id = B.pria_workflow_id 
						LEFT JOIN 
							$this->tbl_pria_tasks D ON A.pria_stage_id = D.pria_stage_id 
						LEFT JOIN 
							$this->tbl_pria_task_document_types E ON D.pria_task_id = E.pria_task_id 
						LEFT JOIN 
							$this->tbl_documents F ON F.reference = B.reference_id AND F.document_type_code = ?
						LEFT JOIN 
							$this->tbl_internal_orders G ON B.reference_id = G.io_id
						LEFT JOIN 
							$this->tbl_pria_task_actions H ON D.pria_task_id = H.pria_task_id AND D.task_status_id = H.pria_task_action_id 
						LEFT JOIN 
							$this->tbl_core_users I ON F.created_by = I.user_id 
						LEFT JOIN 
							$this->tbl_core_users J ON F.modified_by = J.user_id 
						LEFT JOIN 
							$this->tbl_pria_task_roles K ON D.pria_task_id = K.pria_task_id 
						LEFT JOIN 
							$this->tbl_core_roles L ON K.role_code = L.role_code
                        WHERE 
							D.pria_task_id = ?";
                    break;
                case TASK_TYPE_ENCODE_DR:

                    array_push($val, DOC_TYPE_DOC_DR);

                    $query =
                        "
						SELECT 
							IFNULL(D.task_status_id, 0) as task_status_id, S.document_type_code, D.pria_task_id, N.role_code,O.role_name, D.task_name, A.stage_name, B.account_group_code,
							G.dr_gr_id, G.dr_num, IFNULL(G.dr_amount, 0) as dr_amount, G.dr_recipient_id, IFNULL(DATE_FORMAT(G.dr_date, '%m/%d/%Y'), '') as dr_date, 
							G.vendor_code, Q.org_code as business_center_org_code, Q.name as business_center, 
							G.site_id, IFNULL(P.official_store_name, P.suggested_store_name) as site_name, 
							R.user_id as recipient_user_id,
							CONCAT(AGDEC(R.fname),' ',IFNULL(AGDEC(R.mname),''),IFNULL(AGDEC(R.lname),'')) as recipient_fullname,
							G.last_dr_flag, G.dr_type_code, M.po_num,
							K.vendor_name, IFNULL(IF(D.returned_flag = 'Y' AND D.task_status_id IN(2,7),'Resubmitted',H.action_name), 'Pending') as task_status_name, 
							S.file_name, S.sys_file_name, S.version, S.created_date, S.created_by,
							CONCAT(AGDEC(T.fname),' ',IFNULL(AGDEC(T.mname),''),IFNULL(AGDEC(T.lname),'')) as created_by_fullname, M.po_id,
                            D.returned_flag,
                            IFNULL(AGDEC(D.actor_name), '') as actor_name
						FROM 
							$this->tbl_pria_workflow_stages A 
						LEFT JOIN 
							$this->tbl_pria_workflows B ON A.pria_workflow_id = B.pria_workflow_id 
						LEFT JOIN 
							$this->tbl_pria_tasks D ON A.pria_stage_id = D.pria_stage_id 
						LEFT JOIN 
							$this->tbl_pria_task_document_types E ON D.pria_task_id = E.pria_task_id 
						LEFT JOIN 
							$this->tbl_delivery_goods_receipt G ON D.reference = G.dr_gr_id 
						LEFT JOIN 
							$this->tbl_pria_task_actions H ON D.pria_task_id = H.pria_task_id AND D.task_status_id = H.pria_task_action_id 
						LEFT JOIN 
							$this->tbl_vendors K ON G.vendor_code = K.vendor_code 
						LEFT JOIN 
							$this->tbl_delivery_goods_reference L ON G.dr_gr_id = L.dr_gr_id 
						LEFT JOIN 
							$this->tbl_purchase_orders M ON B.reference_id = M.po_id 
						LEFT JOIN 
							$this->tbl_pria_task_roles N ON D.pria_task_id = N.pria_task_id 
						LEFT JOIN 
							$this->tbl_core_roles O ON N.role_code = O.role_code 
						LEFT JOIN 
							$this->tbl_sites P ON G.site_id = P.site_id 
						LEFT JOIN 
							$this->tbl_business_center Q ON P.org_code = Q.org_code 
						LEFT JOIN 
							$this->tbl_core_users R ON G.dr_recipient_id = R.user_id 
						LEFT JOIN 
							$this->tbl_documents S ON D.reference = S.reference AND S.document_type_code = ?
						LEFT JOIN 
							$this->tbl_core_users T ON S.created_by = T.user_id 
						WHERE 
							D.pria_task_id = ?		
						";
                    break;
                case TASK_TYPE_RETURN_APPROVE_SOA:

                    array_push($val, DOC_TYPE_SOA);

                    $query    =
                        "SELECT 
			                IFNULL(D.task_status_id, 0) as task_status_id, D.pria_task_id, L.role_code, M.role_name, D.task_name, A.stage_name, B.account_group_code,
							IFNULL(B.reference_id, '') as soa_id, 
							IFNULL(B.reference_num, '') as soa_num, 
							IFNULL(K.vendor_name, '') as vendor_name,
							IFNULL(DATE_FORMAT(G.soa_date, '%m/%d/%Y'), '') as soa_date,
							IFNULL(IF(D.returned_flag = 'Y' AND D.task_status_id IN(2,7),'Resubmitted',H.action_name), 'Pending') as task_status_name,
							IFNULL(F.document_type_code, '') as document_type_code, 
							CONCAT(AGDEC(I.fname),' ',IFNULL(AGDEC(I.mname),''),IFNULL(AGDEC(I.lname),'')) as created_by,
							CONCAT(AGDEC(J.fname),' ',IFNULL(AGDEC(J.mname),''),IFNULL(AGDEC(J.lname),'')) as modified_by,
							F.file_name, F.sys_file_name, F.version, 
							F.created_date, IFNULL(F.modified_date, '') as modified_date,
                            D.returned_flag,
                            IFNULL(AGDEC(D.actor_name), '') as actor_name
			            FROM 
			            	$this->tbl_pria_workflow_stages A 
						LEFT JOIN 
							$this->tbl_pria_workflows B ON A.pria_workflow_id = B.pria_workflow_id 
						LEFT JOIN 
							$this->tbl_pria_tasks D ON A.pria_stage_id = D.pria_stage_id 
						LEFT JOIN 
							$this->tbl_pria_task_document_types E ON D.pria_task_id = E.pria_task_id 
						LEFT JOIN 
							$this->tbl_documents F ON F.reference = B.reference_id AND F.document_type_code = ?
						LEFT JOIN 
							$this->tbl_soa G ON F.reference = G.soa_id 
						LEFT JOIN 
							$this->tbl_pria_task_actions H ON D.pria_task_id = H.pria_task_id AND D.task_status_id = H.pria_task_action_id 
						LEFT JOIN 
							$this->tbl_core_users I ON F.created_by = I.user_id 
						LEFT JOIN 
							$this->tbl_core_users J ON F.modified_by = J.user_id 
						LEFT JOIN 
							$this->tbl_vendors K ON G.vendor_code = K.vendor_code 
						LEFT JOIN 
							$this->tbl_pria_task_roles L ON D.pria_task_id = L.pria_task_id 
						LEFT JOIN 
							$this->tbl_core_roles M ON L.role_code = M.role_code 
						WHERE 
							D.pria_task_id = ?";

                    break;
                default:
                    break;
            }
        } catch (PDOException $e) {
            throw $e;
        }

        array_push($val, $pria_task_id);
        $stmt     = $this->query($query, $val);

        return $stmt;
    }

    public function get_all_documents_by_user_id($where)
    {
        $stmt         = array();
        $params = array(
            $where['user_id'], $where['pattern']
        );

        try {
            $query    =
                "SELECT 
               	CONCAT(AGDEC(B.fname),' ',IFNULL(AGDEC(B.mname),''),IFNULL(AGDEC(B.lname),'')) as created_by,
				IFNULL(CONCAT(AGDEC(C.fname),' ',IFNULL(AGDEC(C.mname),''),IFNULL(AGDEC(C.lname),'')), '') as modified_by,
				A.file_name, A.sys_file_name, A.version, 
				A.created_date, IFNULL(A.modified_date, '') as modified_date 
            FROM 
            	$this->tbl_documents A
			LEFT JOIN 
				$this->tbl_core_users B ON A.created_by = B.user_id 
			LEFT JOIN 
				$this->tbl_core_users C ON A.modified_by = C.user_id 
			WHERE 
				A.created_by = ? AND A.file_name LIKE CONCAT('%',?,'%')
            ORDER BY A.document_id DESC";

            $stmt     = $this->query($query, $params);
        } catch (PDOException $e) {
            throw $e;
        }

        return $stmt;
    }

    public function get_all_assigned_task_name_for_dropdown($where)
    {
        $stmt         = array();
        $val = array(
            $where['workflow_for_id'],
            $where['role_code'],
            $where['user_id']
        );

        try {
            $query    =
                "SELECT 
               	A.task_name 
            FROM 
            	$this->tbl_pria_tasks A
			JOIN 
				$this->tbl_pria_workflow_stages B ON A.pria_stage_id = B.pria_stage_id 
			JOIN 
				$this->tbl_pria_workflows C ON B.pria_workflow_id = C.pria_workflow_id 
			JOIN 
				$this->tbl_account_groups F ON C.account_group_code = F.account_group_code 
			JOIN 
				$this->tbl_pria_task_roles G ON A.pria_task_id = G.pria_task_id AND C.workflow_for_type = G.role_code
			WHERE 
				C.workflow_for_id = ? AND G.role_code = ? OR A.user_id = ?
			GROUP BY A.task_name 
            ORDER BY A.task_name DESC";
            $stmt     = $this->query($query, $val);
        } catch (PDOException $e) {
            throw $e;
        }

        return $stmt;
    }

    public function get_all_payments_revamped($where, $having)
    {
        $stmt = array();
        $params = array();
        $reference_type_codes = array();
        $core_workflow_task_ids = array();

        $account_group_code_placeholder = "?";
        $transaction_tab_placeholder = "?";
        $core_workflow_task_id_placeholder = "?";

        $extended_statement = "";

        $reference_type_code = $this->reference_type_codes[$where['ag_code']];
        $reference_type_code = $reference_type_code != null ? $reference_type_code : APV_REF_TYPE_CODE_IO;
        $having = str_replace('org_code', 'A.org_code', str_replace('vendor_code', 'A.vendor_code', $having));

        if (!empty($where['ag_code'])) {
            $reference_type_codes = array($reference_type_code);
            $core_workflow_task_ids = array($this->last_ag_tasks[$where['ag_code']]);

            array_push($params, $where['ag_code']);
            $params = array_merge($params, $reference_type_codes);
            $params = array_merge($params, $core_workflow_task_ids);
        } else {
            $account_groups = $this->get_all_account_groups_for_dropdown($where['vendor_code'], null, $where['user_id']);
            $core_workflow_task_ids = array();
            $length = 0;

            foreach ($account_groups as $value) {
                $length++;
                $json = json_decode(json_encode($value), true);
                array_push($params, $json['account_group_code']);
                $core_workflow_task_id = $this->last_ag_tasks[$json['account_group_code']];

                if (!empty($core_workflow_task_id)) {
                    array_push($core_workflow_task_ids, $core_workflow_task_id);
                }
            }

            $reference_type_codes = array(APV_REF_TYPE_CODE_IO, APV_REF_TYPE_CODE_PO, APV_REF_TYPE_CODE_SOA);
            $account_group_code_placeholder = $this->dynamic_placeholder($length);
            $transaction_tab_placeholder = $this->dynamic_placeholder(count($reference_type_codes));
            $core_workflow_task_id_placeholder = $this->dynamic_placeholder(count($core_workflow_task_ids));

            $params = array_merge($params, $reference_type_codes);
            $params = array_merge($params, $core_workflow_task_ids);

            if (!empty($where['vendor_code'])) {
                $ag_code = $this->get_account_group_code_by_vendor_code($where['vendor_code']);
                $reference_type_code = $this->reference_type_codes[$ag_code];
            }
        }

        $params = array_merge($params, array(TASK_STATUS_DONE, TASK_STATUS_APPROVED, ENUM_YES));
        $params = array_merge($params, $core_workflow_task_ids);
        $params = array_merge($params, array(TASK_STATUS_DONE, TASK_STATUS_APPROVED));
        $params = array_merge($params, $reference_type_codes);

        if (!empty($where['vendor_code'])) {
            array_push($params, $where['vendor_code']);
            $extended_statement .= " AND A.vendor_code = ?";
        }

        if (!empty($where['apv_num'])) {
            array_push($params, $where['apv_num']);
            $extended_statement .= " AND F.apv_nums = ?";
        }

        if (!empty($where['cv_num'])) {
            array_push($params, $where['cv_num']);
            $extended_statement .= " AND F.cv_nums = ?";
        }

        if (!empty($where['apv_status'])) {
            if ($where['apv_status'] != "For Payment Processing") {
                array_push($params, $where['apv_status']);
            }

            $extended_statement .= $where['apv_status'] == "For Payment Processing" ? " AND E.payment_id IS NULL" : " AND F.apv_statuses = ?";
        }

        if (!empty($where['org_code'])) {
            array_push($params, $where['org_code']);
            $extended_statement .= " AND A.org_code = ?";
        } else {
            $user_org_code = $this->get_org_code_by_user_id($where['user_id']);
            $vendor_code =  $this->get_vendor_code_by_user_id($where['user_id']);
            $business_centers = $this->get_all_business_centers_for_dropdown($user_org_code, $where['user_id'], $vendor_code);

            $org_codes = array_map(function ($bc) {
                return $bc['org_code'];
            }, $business_centers);
            $bc_placeholder = $this->dynamic_placeholder(count($org_codes));
            $extended_statement .= " AND A.org_code IN($bc_placeholder)";

            $params = array_merge($params, $org_codes);
        }

        // Set main table/fields
        $primary_key = null;
        $reference_num = "'---'";
        $parent_table = null;
        $placeholder = "'---'";

        // IO
        $io_actual_clean_up_date = $placeholder;
        $io_harvest_rep_submit_date = $placeholder;
        $io_fhr_submit_date = $placeholder;

        // PO
        $po_date = $placeholder;
        $po_amount = $placeholder;
        $po_released_date = $placeholder;

        // SOA
        $soa_date = $placeholder;
        $soa_amount = $placeholder;
        $soa_submission_date = $placeholder;
        $soa_date_from = $placeholder;
        $soa_date_to = $placeholder;
        
        switch ($reference_type_code) {
            case APV_REF_TYPE_CODE_IO:
                $primary_key = "A.io_id";
                $reference_num = "A.io_num";
                $io_actual_clean_up_date = "IFNULL(DATE_FORMAT(A.actual_clean_up_date, '%d-%b-%Y'), '---')";
                $io_harvest_rep_submit_date = "IFNULL(DATE_FORMAT(A.harvest_rep_submit_date, '%d-%b-%Y'), '---')";
                $io_fhr_submit_date = "IFNULL(DATE_FORMAT(A.fhr_submit_date, '%d-%b-%Y'), '---')";
                $parent_table = $this->tbl_internal_orders;
                break;
            case APV_REF_TYPE_CODE_PO:
                $primary_key = "A.po_id";
                $reference_num = "A.po_num";
                $po_date = "IFNULL(DATE_FORMAT(A.po_date, '%d-%b-%Y'), '---')";
                $po_amount = "IFNULL(FORMAT(A.po_amount, 2), '---')";
                $po_released_date = "IFNULL(DATE_FORMAT(A.po_released_date, '%d-%b-%Y'), '---')";
                $parent_table = $this->tbl_purchase_orders;
                break;
            case APV_REF_TYPE_CODE_SOA:
                $primary_key = "A.soa_id";
                $reference_num = "A.soa_num";
                $soa_date = "IFNULL(DATE_FORMAT(A.soa_date, '%d-%b-%Y'), '---')";
                $soa_amount = "IFNULL(FORMAT(A.soa_amount, 2), '---')";
                $soa_submission_date = "IFNULL(DATE_FORMAT(A.submission_date, '%d-%b-%Y'), '---')";
                $soa_date_from = "IFNULL(DATE_FORMAT(A.date_from, '%d-%b-%Y'), '---')";
                $soa_date_to = "IFNULL(DATE_FORMAT(A.date_to, '%d-%b-%Y'), '---')";
                $parent_table = $this->tbl_soa;
                break;
        }

        try {
            $query = "SELECT IFNULL(H.vendor_name, '---') vendor_name, I.account_group_name, 
                        IF((C.pria_stage_id IS NOT NULL OR D.pria_stage_id IS NOT NULL) AND E.payment_id IS NULL, '---', F.apv_nums) AS apv_num,
                        IFNULL(E.account_group_code, B.account_group_code) AS account_group_code,
                        IFNULL(E.vendor_code, B.vendor_code) AS vendor_code,
                        IFNULL(E.reference_type_code, '$reference_type_code') AS reference_type_code,
                        IFNULL(E.reference_id, B.reference_id) AS reference_id,
                        IF((C.pria_stage_id IS NOT NULL OR D.pria_stage_id IS NOT NULL) AND E.payment_id IS NULL, '---', F.apv_dates) AS apv_date, 
                        IF((C.pria_stage_id IS NOT NULL OR D.pria_stage_id IS NOT NULL) AND E.payment_id IS NULL, '---', F.apv_amounts) AS apv_amount, 
                        IF((C.pria_stage_id IS NOT NULL OR D.pria_stage_id IS NOT NULL) AND E.payment_id IS NULL, null, F.apv_status_code) AS apv_status_code, 
                        IF((C.pria_stage_id IS NOT NULL OR D.pria_stage_id IS NOT NULL) AND E.payment_id IS NULL, 'For Payment Processing', F.apv_statuses) AS apv_status_name, 
                        IF(E.reference_type_code IS NULL, B.reference_num, $reference_num) AS reference_num,
                        IF(E.reference_type_code IS NULL, B.org_code, A.org_code) AS reference_org_code,
                        $io_actual_clean_up_date AS io_actual_clean_up_date, 
                        $io_harvest_rep_submit_date AS io_harvest_rep_submit_date,
                        $io_fhr_submit_date AS io_fhr_submit_date,
                        $po_date AS po_date,
                        $po_amount AS po_amount,
                        $po_released_date AS po_released_date,
                        $soa_date AS soa_date, 
                        $soa_amount AS soa_amount,
                        $soa_submission_date AS soa_submission_date,
                        $soa_date_from AS soa_date_from,
                        $soa_date_to AS soa_date_to,
                        IF((C.pria_stage_id IS NOT NULL OR D.pria_stage_id IS NOT NULL) AND E.payment_id IS NULL, '---', F.cv_nums) AS cv_num,
                        IF((C.pria_stage_id IS NOT NULL OR D.pria_stage_id IS NOT NULL) AND E.payment_id IS NULL, '---', F.cv_amounts) AS cv_amount,
                        G.name AS business_center_name
                        FROM $parent_table A
                        LEFT JOIN $this->tbl_pria_workflows B ON $primary_key = B.reference_id
                        AND B.account_group_code IN($account_group_code_placeholder) 
                        AND B.core_workflow_id IN (
                            SELECT core_workflow_id FROM $this->tbl_pria_tab_modules
                            WHERE ag_code = B.account_group_code AND transaction_tab IN($transaction_tab_placeholder)
                        )
                        LEFT JOIN (
                            SELECT AZ.pria_workflow_id, AZ.pria_stage_id, AZ.core_workflow_stage_id
                            FROM $this->tbl_pria_workflow_stages AZ
                            LEFT JOIN $this->tbl_pria_tasks AY ON AZ.pria_stage_id = AY.pria_stage_id
                            AND AY.core_workflow_task_id IN ($core_workflow_task_id_placeholder)
                            AND AY.task_status_id IN (?, ?)
                            WHERE AY.pria_task_id IS NOT NULL
                        ) C ON B.pria_workflow_id = C.pria_workflow_id
                        AND C.core_workflow_stage_id NOT IN (
                            SELECT CC.workflow_stage_id FROM $this->tbl_pria_task_appendable AA
                            JOIN $this->tbl_pria_tasks BB ON AA.pria_task_id = BB.pria_task_id
                            JOIN $this->tbl_core_workflow_stage_tasks CC ON BB.core_workflow_task_id = CC.workflow_task_id
                            WHERE AA.pria_task_id IN (
                                SELECT pria_task_id FROM $this->tbl_pria_tasks WHERE pria_stage_id = C.pria_stage_id
                            )
                            UNION
                            SELECT EE.workflow_stage_id FROM $this->tbl_pria_task_appendable DD
                            JOIN $this->tbl_core_workflow_stages EE ON DD.core_workflow_id = EE.workflow_id
                            WHERE DD.pria_task_id IN (
                                SELECT pria_task_id FROM $this->tbl_pria_tasks WHERE pria_stage_id = C.pria_stage_id
                            )
                        )
                        LEFT JOIN (
                            SELECT AZ.pria_workflow_id, AZ.pria_stage_id, AZ.core_workflow_stage_id
                            FROM $this->tbl_pria_workflow_stages AZ
                            LEFT JOIN $this->tbl_pria_tasks AY ON AZ.pria_stage_id = AY.pria_stage_id
                            LEFT JOIN $this->tbl_delivery_goods_receipt AX ON AY.pria_task_id = AX.pria_task_id and AX.last_dr_flag = ?
                            LEFT JOIN $this->tbl_pria_tasks AW ON AY.pria_stage_id = AW.pria_stage_id
                            AND AW.core_workflow_task_id IN ($core_workflow_task_id_placeholder)
                            AND AW.task_status_id IN (?, ?)
                            WHERE AW.pria_task_id IS NOT NULL
                        ) D ON B.pria_workflow_id = D.pria_workflow_id
                        AND D.core_workflow_stage_id IN (
                            SELECT CC.workflow_stage_id FROM $this->tbl_pria_task_appendable AA
                            JOIN $this->tbl_pria_tasks BB ON AA.pria_task_id = BB.pria_task_id
                            JOIN $this->tbl_core_workflow_stage_tasks CC ON BB.core_workflow_task_id = CC.workflow_task_id
                            WHERE AA.pria_task_id IN (
                                SELECT pria_task_id FROM $this->tbl_pria_tasks WHERE pria_stage_id = D.pria_stage_id
                            )
                            UNION
                            SELECT EE.workflow_stage_id FROM $this->tbl_pria_task_appendable DD
                            JOIN $this->tbl_core_workflow_stages EE ON DD.core_workflow_id = EE.workflow_id
                            WHERE DD.pria_task_id IN (
                                SELECT pria_task_id FROM $this->tbl_pria_tasks WHERE pria_stage_id = D.pria_stage_id
                            )
                        )
                        LEFT JOIN $this->tbl_payments E ON $primary_key = E.reference_id AND B.account_group_code = E.account_group_code AND E.reference_type_code IN($transaction_tab_placeholder)
                        LEFT JOIN $this->tbl_organizations G ON A.org_code = G.org_code
                        LEFT JOIN (
                            SELECT
                                FF.apv_status_code,
                                FF.payment_id,
                                IFNULL(FF.apv_num, '---') AS apv_nums,
                                IFNULL(DATE_FORMAT(FF.apv_date, '%d-%b-%Y'), '---') AS apv_dates,
                                FF.apv_date AS apv_dates_raw,
                                IFNULL(FORMAT(FF.apv_amount, 2), '---') AS apv_amounts,
                                IFNULL(FF.cv_num, '---') AS cv_nums,
                                IFNULL(FORMAT(FF.cv_amount, 2), '---') AS cv_amounts,
                                IFNULL(FF.particulars, '---') AS apv_particulars,
                                IFNULL(GG.apv_status_name, '---') AS apv_statuses,
                                GG.apv_status_id AS apv_statuses_id
                            FROM $this->tbl_payment_apvs FF
                            LEFT JOIN $this->tbl_param_apv_status GG ON FF.apv_status_code = GG.apv_status_id
                        ) F ON E.payment_id = F.payment_id
                        LEFT JOIN $this->tbl_vendors H ON IFNULL(E.vendor_code, B.vendor_code) = H.vendor_code
                        LEFT JOIN $this->tbl_account_groups I ON IFNULL(E.account_group_code, B.account_group_code) = I.account_group_code
                        WHERE (C.pria_stage_id IS NOT NULL OR D.pria_stage_id IS NOT NULL OR E.payment_id IS NOT NULL)
                        $having
                        $extended_statement
                        ORDER BY  E.created_date DESC";
                        
            $stmt     = $this->query($query, $params);
        } catch (PDOException $e) {
            throw $e;
        }

        return $stmt;
    }

    public function get_all_payments_lessors_revamped($where, $having)
    {
        $reference_type_code = TRANS_TAB_CONTRACTS;
        $stmt = array();
        $extended_statement = "";
        $params = array(AG_LESSORS, $reference_type_code, DOC_TYPE_SIGNED_RENEWAL, AG_LESSORS, CONTRACT_STATUS_NEW);

        $having = str_replace('org_code', 'A.org_code', str_replace('vendor_code', 'A.vendor_code', $having));

        if (!empty($where['vendor_code'])) {
            array_push($params, $where['vendor_code']);
            $extended_statement .= " AND A.vendor_code = ?";
        }

        if (!empty($where['apv_num'])) {
            array_push($params, $where['apv_num']);
            $extended_statement .= " AND F.apv_nums = ?";
        }

        if (!empty($where['cv_num'])) {
            array_push($params, $where['cv_num']);
            $extended_statement .= " AND F.cv_nums = ?";
        }

        if (!empty($where['apv_status'])) {
            if ($where['apv_status'] != "For Payment Processing") {
                array_push($params, $where['apv_status']);
            }

            $extended_statement .= $where['apv_status'] == "For Payment Processing" ? " AND E.payment_id IS NULL" : " AND F.apv_statuses = ?";
        }

        if (!empty($where['org_code'])) {
            array_push($params, $where['org_code']);
            $extended_statement .= " AND A.org_code IN(?)";
        } else {
            $user_org_code = $this->get_org_code_by_user_id($where['user_id']);
            $business_centers = $this->get_all_business_centers_for_dropdown($user_org_code, $where['user_id'], $where['vendor_code']);

            $org_codes = array_map(function ($bc) {
                return $bc['org_code'];
            }, $business_centers);
            $bc_placeholder = $this->dynamic_placeholder(count($org_codes));
            $extended_statement .= " AND A.org_code IN($bc_placeholder)";

            $params = array_merge($params, $org_codes);
        }

        try {
            $query = "SELECT 
                        IFNULL(M.vendor_name, O.vendor_name) vendor_name,
                        N.account_group_name,
                        IF(E.payment_id IS NULL, '---', F.apv_nums) AS apv_num, 
                        IFNULL(E.account_group_code, ?) AS account_group_code,
                        E.vendor_code,
                        IFNULL(E.reference_type_code, '') AS reference_type_code,
                        E.reference_id,
                        IF(E.payment_id IS NULL, '---', F.apv_dates) AS apv_date, 
                        IF(E.payment_id IS NULL, '---', F.apv_amounts) AS apv_amount, 
                        IF(E.payment_id IS NULL, null, F.apv_status_code) AS apv_status_code, 
                        IF(E.payment_id IS NULL, 'For Payment Processing', F.apv_statuses) AS apv_status_name,
                        A.contract_code AS reference_num,
                        A.org_code AS reference_org_code,
                        '---' AS io_actual_clean_up_date, 
                        '---' AS io_harvest_rep_submit_date,
                        '---' AS io_fhr_submit_date,
                        '---' AS po_date,
                        '---' AS po_amount,
                        '---' AS po_released_date,
                        '---' AS soa_date, 
                        '---' AS soa_amount,
                        '---' AS soa_submission_date,
                        '---' AS soa_date_from,
                        '---' AS soa_date_to,
                        IF(E.payment_id IS NULL, '---', F.cv_nums) AS cv_num, 
                        IF(E.payment_id IS NULL, '---', F.cv_amounts) AS cv_amount,
                        G.name AS business_center_name
                        FROM $this->tbl_contracts A
                        LEFT JOIN $this->tbl_payments E ON A.contract_id = E.reference_id
                        AND A.account_group_code = E.account_group_code AND E.reference_type_code = ?
                        LEFT JOIN (
                            SELECT
                                FF.apv_status_code,
                                FF.payment_id,
                                IFNULL(FF.apv_num, '---') AS apv_nums,
                                IFNULL(DATE_FORMAT(FF.apv_date, '%d-%b-%Y'), '---') AS apv_dates,
                                FF.apv_date AS apv_dates_raw,
                                IFNULL(FORMAT(FF.apv_amount, 2), '---') AS apv_amounts,
                                IFNULL(FF.cv_num, '---') AS cv_nums,
                                IFNULL(FORMAT(FF.cv_amount, 2), '---') AS cv_amounts,
                                IFNULL(FF.particulars, '---') AS apv_particulars,
                                IFNULL(GG.apv_status_name, '---') AS apv_statuses,
                                GG.apv_status_id AS apv_statuses_id
                            FROM $this->tbl_payment_apvs FF
                            LEFT JOIN $this->tbl_param_apv_status GG ON FF.apv_status_code = GG.apv_status_id
                        ) F ON E.payment_id = F.payment_id
                        LEFT JOIN $this->tbl_organizations G ON A.org_code = G.org_code
                        LEFT JOIN $this->tbl_documents L ON A.original_contract_id = L.reference
                        AND A.account_group_code = L.account_group_code AND L.document_type_code = ?
                        LEFT JOIN $this->tbl_vendors M ON E.vendor_code = M.vendor_code
                        LEFT JOIN $this->tbl_vendors O ON A.vendor_code = O.vendor_code
                        LEFT JOIN $this->tbl_account_groups N ON IFNULL(E.account_group_code, ?) = N.account_group_code
                        WHERE (A.contract_status_code = ? OR F.payment_id IS NOT NULL)
                        $having
                        $extended_statement
                        ORDER BY E.created_date desc";
            $stmt     = $this->query($query, $params);
        } catch (PDOException $e) {
            throw $e;
        }

        return $stmt;
    }

    public function get_all_payments($where)
    {
        $stmt         = array();
        $params = array(
            $where['vendor_code']
        );
        $vendor_code_removed = false;

        //If parameters has no values, omit WHERE keyword
        $where_keyword = $where['vendor_code'] != null || !empty($where['apv_num']) || !empty($where['cv_num']) || !empty($where['apv_status']) || !empty($where['ag_code']) || !empty($where['org_code']) ? "WHERE" : "";
        $extended_statement = '';

        if ($where['vendor_code'] != null) {
            $extended_statement .= "B.vendor_code IN(?)";
        }

        if (!empty($where['apv_num'])) {
            //If there is a preceding condition, show AND keyword
            $and_keyword = !empty($extended_statement) ? 'AND' : '';
            $extended_statement .= " $and_keyword A.apv_num IN('" . $where['apv_num'] . "')";
        }

        if (!empty($where['cv_num'])) {
            //If there is a preceding condition, show AND keyword
            $and_keyword = !empty($extended_statement) ? 'AND' : '';
            $extended_statement .= " $and_keyword A.cv_num IN('" . $where['cv_num'] . "')";
        }

        if (!empty($where['apv_status'])) {
            //If there is a preceding condition, show AND keyword
            $and_keyword = !empty($extended_statement) ? 'AND' : '';
            $extended_statement .= " $and_keyword C.apv_status_name IN('" . $where['apv_status'] . "')";
        }

        if (!empty($where['ag_code'])) {
            //If there is a preceding condition, show AND keyword
            $and_keyword = !empty($extended_statement) ? 'AND' : '';
            $extended_statement .= " $and_keyword B.account_group_code IN('" . $where['ag_code'] . "')";
        } else {
            $account_groups = $this->get_all_account_groups_for_dropdown($where['vendor_code'], null, $where['user_id']);

            if ($where['vendor_code'] == null && !$vendor_code_removed) {
                array_shift($params);
                $vendor_code_removed = true;
            }

            $length = 0;

            foreach ($account_groups as $value) {
                $length++;
                $json = json_decode(json_encode($value), true);
                array_push($params, $json['account_group_code']);
            }

            //If there is a preceding condition, show AND keyword
            $and_keyword = !empty($extended_statement) ? 'AND' : '';
            $placeholder = $this->dynamic_placeholder($length);
            $extended_statement .= " $and_keyword B.account_group_code IN($placeholder)";

            if (empty($where_keyword)) {
                $where_keyword = 'WHERE';
            }
        }

        if (!empty($where['org_code'])) {
            //If there is a preceding condition, show AND keyword
            $and_keyword = !empty($extended_statement) ? 'AND' : '';
            $extended_statement .= " $and_keyword 
										(CASE B.reference_type_code
											WHEN '$this->apv_ref_type_code_io' THEN D.org_code 
										    WHEN '$this->apv_ref_type_code_po' THEN E.org_code
										    WHEN '$this->apv_ref_type_code_soa' THEN F.org_code 
										    ELSE '' 
										END) IN('" . $where['org_code'] . "')";
        } else {
            $business_centers = $this->get_all_business_centers_for_dropdown($where['user_org_code'], $where['user_id'], $where['vendor_code']);

            if ($where['vendor_code'] == null && !$vendor_code_removed) {
                array_shift($params);
                $vendor_code_removed = true;
            }

            $length = 0;

            foreach ($business_centers as $value) {
                $length++;
                $json = json_decode(json_encode($value), true);
                array_push($params, $json['org_code']);
            }

            //If there is a preceding condition, show AND keyword
            $and_keyword = !empty($extended_statement) ? 'AND' : '';
            $placeholder = $this->dynamic_placeholder($length);
            $extended_statement .= " $and_keyword 
										(CASE B.reference_type_code
											WHEN '$this->apv_ref_type_code_io' THEN D.org_code 
										    WHEN '$this->apv_ref_type_code_po' THEN E.org_code
										    WHEN '$this->apv_ref_type_code_soa' THEN F.org_code 
										    ELSE '' 
										END) IN($placeholder)";
        }

        try {
            $query    = <<<EOS
			SELECT 
				IFNULL(A.apv_num,'N/A') as apv_num, B.account_group_code, B.vendor_code, 
				B.reference_type_code, B.reference_id, IFNULL(DATE_FORMAT(A.apv_date, '%m/%d/%Y'),'N/A') as apv_date,
				IFNULL(FORMAT(A.apv_amount, 2),'N/A') as apv_amount, A.apv_status_code, C.apv_status_name, 
				CASE B.reference_type_code
					WHEN '$this->apv_ref_type_code_io' THEN D.io_num 
				    WHEN '$this->apv_ref_type_code_po' THEN E.po_num
				    WHEN '$this->apv_ref_type_code_soa' THEN F.soa_num 
				    ELSE '' 
				END as reference_num,
				CASE B.reference_type_code
					WHEN '$this->apv_ref_type_code_io' THEN D.org_code 
				    WHEN '$this->apv_ref_type_code_po' THEN E.org_code
				    WHEN '$this->apv_ref_type_code_soa' THEN F.org_code 
				    ELSE '' 
				END as reference_org_code,
				IFNULL(DATE_FORMAT(D.actual_clean_up_date, '%m/%d/%Y'), 'N/A') as io_actual_clean_up_date, 
				IFNULL(DATE_FORMAT(D.harvest_rep_submit_date, '%m/%d/%Y'), 'N/A') as io_harvest_rep_submit_date, 
				IFNULL(DATE_FORMAT(D.fhr_submit_date, '%m/%d/%Y'), 'N/A') as io_fhr_submit_date,
				IFNULL(DATE_FORMAT(E.po_date, '%m/%d/%Y'), 'N/A') as po_date, 
				IFNULL(FORMAT(E.po_amount, 2), 'N/A') as po_amount, 
				IFNULL(DATE_FORMAT(E.po_released_date, '%m/%d/%Y'), 'N/A') as po_released_date,
				IFNULL(DATE_FORMAT(F.soa_date, '%m/%d/%Y'), 'N/A') as soa_date, 
				IFNULL(FORMAT(F.soa_amount, 2), 'N/A') as soa_amount, 
				IFNULL(DATE_FORMAT(F.submission_date,'%m/%d/%Y'), 'N/A') as soa_submission_date,
				IFNULL(A.cv_num, '') as cv_num, IFNULL(FORMAT(A.cv_amount, 2), '') as cv_amount 
			FROM 
				$this->tbl_payment_apvs A 
			LEFT JOIN 
				$this->tbl_payments B ON A.payment_id = B.payment_id 
			LEFT JOIN 
				$this->tbl_param_apv_status C ON A.apv_status_code = C.apv_status_id 
			LEFT JOIN 
				$this->tbl_internal_orders D ON B.reference_id = D.io_id 
			LEFT JOIN 
				$this->tbl_purchase_orders E ON B.reference_id = E.po_id 
			LEFT JOIN 
				$this->tbl_soa F ON B.reference_id = F.soa_id 
			$where_keyword 
				$extended_statement
EOS;

            $stmt     = $this->query($query, $params);
        } catch (PDOException $e) {
            throw $e;
        }

        return $stmt;
    }

    public function get_all_business_centers_for_dropdown($org_code, $user_id, $vendor_code, $is_sign_up = false, $acc_group = "", $trans_tab = "")
    {
        $stmt         = array();
        $is_system_wide = false;
        $val = array();
        try {
            if ($vendor_code == null && !$is_sign_up) {
                $params = array();
                $role_codes = $this->get_role_code_by_user_id($user_id);

                $length = 0;

                foreach ($role_codes as $value) {
                    $length++;
                    array_push($params, $value['role_code']);
                }

                $role_code_placeholder = $this->dynamic_placeholder($length);

                $scope = $this->get_scope($params, $role_code_placeholder)[0]['scope'];

                $is_system_wide = $scope == 'SCOPE_SYSTEM';
            } elseif ($is_sign_up) {
                $is_system_wide = true;
            }
            if(!empty($vendor_code) ||  $vendor_code != null){
                $extended_statement = !$is_system_wide ? 'AND b.vendor_code = ?' : '';
                $val = !$is_system_wide ? array(ORG_TYPE_BUSINESS_CENTER, $vendor_code) : array(ORG_TYPE_BUSINESS_CENTER);
            }else{
                $extended_statement = !$is_system_wide ? 'AND a.org_code = ?' : '';
                $org_code = $this->get_org_code_by_user_id($user_id);
                $val = !$is_system_wide ? array(ORG_TYPE_BUSINESS_CENTER, $org_code) : array(ORG_TYPE_BUSINESS_CENTER);
            }
            



            if (!empty($acc_group)) {
                $extended_statement .= $acc_group ? 'AND c.account_group_code = ?' : '';
                array_push($val, $acc_group);
            }


            $query    =
                "SELECT 
                a.org_code, a.org_type_code, a.location_code, a.short_name, a.name 
            FROM 
            	$this->tbl_business_center as a
            JOIN $this->tbl_vendor_business_centers as b
                on a.org_code = b.org_code
            JOIN $this->tbl_vendor_account_group  as c 
                on b.vendor_code = c.vendor_code 
            WHERE 
            	a.org_type_code = ? 
			$extended_statement 
            GROUP BY org_code
            ORDER BY 
                name ASC";
            $stmt     = $this->query($query, $val);
        } catch (PDOException $e) {
            throw $e;
        }

        return $stmt;
    }

    public function get_role_code_by_user_id($user_id)
    {
        $stmt = array();
        $param = array($user_id);

        try {
            $query = "SELECT 
                        role_code 
                    FROM 
                        $this->tbl_user_roles
                    WHERE 
                        user_id = ?";

            $stmt = $this->query($query, $param);
        } catch (PDOException $e) {
            throw $e;
        }

        return $stmt;
    }

    public function get_scope($params, $placeholder)
    {
        $stmt = array();
        //Inserts element at start of array
        array_unshift($params, MODULE_PORTAL_DASHBOARD);

        try {
            $query = "SELECT 
                        scope 
                    FROM 
                        $this->tbl_core_module_scope_roles A
                    JOIN 
                        $this->tbl_core_sys_param B
                    ON 
                        A.scope = B.sys_param_code
                    WHERE 
                        module_code = ? 
                    AND 
                        role_code IN($placeholder) 
                    GROUP BY 
                        scope 
                    ORDER BY 
                        B.sys_param_value 
                    LIMIT 1";

            $stmt = $this->query($query, $params);
        } catch (PDOException $e) {
            throw $e;
        }

        return $stmt;
    }

    public function get_task_status_names_for_dropdown($action1 = null, $action2 = null)
    {
    
        $stmt = array();
        $extended_statement = "";
        if($action1 != null & $action2 != null) {
            $extended_statement .= "and action_name NOT IN ('".$action1."', '".$action2."')";
        }

        try {
            $query = "SELECT DISTINCT action_name
						FROM
						$this->tbl_pria_task_actions 
                        WHERE 1 = 1  $extended_statement
                        ORDER BY action_name";
            $stmt = $this->query($query);
        } catch (PDOException $e) {
            throw $e;
        }

        return $stmt;
    }

    public function get_all_locations_by_org_code_for_dropdown($org_code, $account_group_code)
    {
        $stmt = array();
        $val = $account_group_code == AG_GOODS_MARINADES ? array($org_code, SITE_TYPE_DRESSING_PLANT, SITE_TYPE_WAREHOUSE) : array($org_code);
        $extended_statement = $account_group_code == AG_GOODS_MARINADES ? 'AND site_type_code IN(?,?)' : '';

        try {
            $query    =
                "SELECT 
                site_id, IFNULL(official_store_name, suggested_store_name) as site_name, site_type_code 
            FROM 
            	$this->tbl_sites 
            WHERE org_code = ? 
			$extended_statement
            ORDER BY site_id ASC";

            $stmt     = $this->query($query, $val);
        } catch (PDOException $e) {
            throw $e;
        }

        return $stmt;
    }

    public function get_all_recipient_by_org_type_code_for_dropdown($org_type_code)
    {
        $stmt         = array();
        $val = array($org_type_code, STATUS_ACTIVE_FLAG);

        try {
            $query    =
                "SELECT 
            	A.user_id, CONCAT(AGDEC(A.fname),' ',IFNULL(AGDEC(A.mname),''),IFNULL(AGDEC(A.lname),'')) as fullname 
			FROM 
				$this->tbl_core_users A 
			LEFT JOIN 
				$this->tbl_core_organizations B ON A.org_code = B.org_code 
			LEFT JOIN 
				$this->tbl_business_center C ON B.org_code = C.org_code 
			WHERE 
				C.org_type_code = ? AND A.status = ?";

            $stmt     = $this->query($query, $val);
        } catch (PDOException $e) {
            throw $e;
        }

        return $stmt;
    }

    public function get_reference_num_rows($where)
    {
        $stmt = array();
        $val  = array($where['reference_num'], $where['account_group_code']);

        try {
            $query = "SELECT 
							COUNT(reference_num) 
						AS 
							reference_num_rows 
						FROM 
							$this->tbl_pria_workflows 
						WHERE 
							reference_num = ? 
						and 
							account_group_code = ?";

            $stmt = $this->query($query, $val);
        } catch (PDOException $e) {
            throw $e;
        }

        return $stmt;
    }

