    public function dynamic_placeholder($length)
    {
        $placeholder = '';
        for ($i = 0; $i < $length; $i++) {
            $is_last_element = $i == $length - 1;
            $placeholder .= $is_last_element ? '?' : '?,';
        }

        return $placeholder;
    }

