    public function get_pre_pria_task_id($pria_task_id)
    {
        $stmt = array();

        $val = array($pria_task_id);

        try {
            $query =
                "SELECT 
				pre_pria_task_id
			FROM
				$this->tbl_pria_task_predecessors
			WHERE pria_task_id = ?";

            $stmt = $this->query($query, $val);
        } catch (PDOException $e) {
            throw $e;
        }

        return $stmt[0]['pre_pria_task_id'];
    }

    public function get_account_group_code_by_po_num($po_num)
    {
        $stmt = array();

        $val = array($po_num);

        try {
            $query =
                "SELECT 
				A.account_group_code 
			FROM 
				$this->tbl_purchase_requisitions A 
			JOIN 
				$this->tbl_purchase_orders B 
			ON 
				A.pr_id = B.pr_id 
			WHERE 
				B.po_num = ?";

            $stmt = $this->query($query, $val);
        } catch (PDOException $e) {
            throw $e;
        }

        return $stmt[0]['account_group_code'];
    }

    public function get_account_group_code_by_vendor_code($vendor_code)
    {
        $stmt = array();

        $val = array($vendor_code);

        try {
            $query =
                "SELECT 
                account_group_code 
            FROM 
                $this->tbl_payments
            WHERE 
            vendor_code = ?";

            $stmt = $this->query($query, $val);
        } catch (PDOException $e) {
            throw $e;
        }

        if (empty($stmt[0]['account_group_code'])) {
            try {
                $query =
                    "SELECT 
                    account_group_code 
                FROM 
                    $this->tbl_pria_workflows
                WHERE 
                vendor_code = ?";

                $stmt = $this->query($query, $val);
            } catch (PDOException $e) {
                throw $e;
            }
        }

        return $stmt[0]['account_group_code'];
    }

    public function get_pria_stage_id_by_task_id($task_id)
    {
        $stmt = array();
        $val = array($task_id);

        try {
            $query = "SELECT 
						pria_stage_id 
					FROM
