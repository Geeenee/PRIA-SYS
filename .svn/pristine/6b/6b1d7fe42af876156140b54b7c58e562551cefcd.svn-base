<div>
	<div class="font-lg m-b-md">DOC Delivery and Receipt</div>
	<div class="row b-t-n m-b-n">
		<div class="col l1 m2 s2 p-l-lg">
			<input type="checkbox" class="labelauty rounded" name="dr_chk[]" value="1" />
		</div>
		<div class="col l8 m7 s8">
			<div class="font-lg">Upload DOC Delivery Receipt <div class="help-text font-sm m-t-xs">assigned to <span class="font-bold">CG Sup</span></div></div>
		</div>
		<div class="col l3 m3 s2 right-align">
			<span class="badge rounded pink lighten-5">Pending</span>
		</div>
	</div>
	
	<!-- DATA ENTRY FORMS -->
	<div class="row b-t-n m-b-n">
		<div class="col l1 m2 s1"></div>
		<div class="col l11 m10 s11">
			<div class="panel-wrapper white">
				<div class="input-field">
					<div class="table-display">
						<div class="table-cell l3 m5 s5 right-align valign-middle p-r-md">			
							<label>DOC DR Date</label>
						</div>

						<div class="table-cell l3 m6 s6 valign-middle">
							<input type="text" class="datepicker" name="doc_dr_date" id="doc_dr_date" placeholder="MM/DD/YYYY" />
						</div>
						<div class="table-cell l6 m1 s1 valign-middle"></div>
					</div>
				</div>
				<div class="input-field">
					<div class="table-display">
						<div class="table-cell l3 m5 s5 right-align valign-middle p-r-md">			
							<label>Actual Placement Date</label>
						</div>

						<div class="table-cell l3 m6 s6 valign-middle">
							<input type="text" class="datepicker" name="actual_placement_date" id="actual_placement_date" placeholder="MM/DD/YYYY"/>
						</div>
						<div class="table-cell l6 m1 s1 valign-middle"></div>
					</div>
				</div>
				<div class="input-field">
					<div class="table-display">
						<div class="table-cell l3 m5 s5 right-align valign-middle p-r-md">			
							<label>DOC DR File</label>
						</div>

						<div class="table-cell l9 m7 s7 valign-middle">
							<div class="input-field">
								<div id="file_upload">Upload</div>
							</div>
						</div>
					</div>
				</div>
				<div class="input-field">
					<div class="table-display">
						<div class="table-cell l3 m5 s5 right-align valign-middle p-r-md">			
							<label>Last DOC Delivery?</label>
						</div>

						<div class="table-cell l9 m7 s7 valign-middle">
							<div class="input-field">
								<input type="checkbox" class="filled-in" name="medvac_deliveries" id="medvac_deliveries" />
								<label for="medvac_deliveries">Checking this box will signify completion of all DOC deliveries</label>
							</div>
						</div>
					</div>
				</div>
				<div class="input-field">
					<div class="table-display">
						<div class="table-cell s3 right-align valign-middle p-r-md"></div>

						<div class="table-cell s9 valign-middle">
							<button type="submit" class="btn">Save</button>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
