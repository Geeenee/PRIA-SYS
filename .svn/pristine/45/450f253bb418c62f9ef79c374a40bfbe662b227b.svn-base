  public function get_all_recipient_by_org_type_code_get(){
    try{
      $success  = 0;
      $org_code    = $this->get('org_code');

      if(EMPTY($org_code))
        throw new Exception($this->lang->line('err_required_org_code'));
      
      /*$recipients       = $this->pria_api_model->get_all_recipient_by_org_type_code_for_dropdown($org_type_code);*/

      $recipients = $this->pria_api_model->get_bavi_recipients_by_org($org_code);

