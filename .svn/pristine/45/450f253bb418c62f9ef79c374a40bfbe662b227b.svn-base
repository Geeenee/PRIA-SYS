  public function get_all_apv_status_get(){
    try{
      $success  = 0;
      
      $apv_status       = $this->pria_api_model->get_all_apv_status_dropdown();
      array_push($apv_status, ['apv_status_id' => null, 'apv_status_name' => 'For Payment Processing']);
      $apv_status_names = array_column($apv_status, 'apv_status_name');
      array_multisort($apv_status_names, SORT_ASC, $apv_status);
      $success  = 1;
    }catch (Exception $e){
      $msg      = $e->getMessage();
    }

    if($success == 1){
      $response = [
        'apv_status' => $apv_status
      ];
    }else{
      $response = [
        'msg'       => $msg,
        'flag'      => $success
      ];
    }

    $this->response($response);
  }
}