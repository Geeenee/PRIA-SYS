  public function get_po_numbers_for_dropdown_get() {
    try {
      $success = 0;
      $vendor_code = $this->get('vendor_code');  
      $org_code = empty($this->get('org_code')) ? null : $this->get('org_code');

      $po_numbers = $this->pria_api_model->get_po_numbers_for_dropdown($vendor_code, $org_code);

      $success = 1;
    }
    catch(Exception $e) {
      $msg = $e->getMessage();
    }

    if($success == 1) {
      $response = [
        'po_numbers_list' => $po_numbers
      ];
    } else {
      $response = [
        'msg' => $msg,
        'flag' => $success
      ];
    }

    $this->response($response);
  }

  public function get_all_account_groups_get(){
    try{
      $success        = 0;
      $vendor_code = empty($this->get('vendor_code')) ? null : $this->get('vendor_code');
      $is_soa = empty($this->get('is_soa')) ? null : $this->get('is_soa');
      $user_id = empty($this->get('user_id')) ? null : $this->get('user_id');

      $account_groups     = $this->pria_api_model->get_all_account_groups_for_dropdown($vendor_code, $is_soa, $user_id);
      $success  = 1;
    }catch (Exception $e){
      $msg      = $e->getMessage();      
    }

    if($success == 1){
      $response = [
        'account_group_list' => $account_groups
      ];
    }else{
      $response = [
        'msg'       => $msg,
        'flag'      => $success
      ];
    }

    $this->response($response);
  }

  public function get_apv_num_or_cv_num_get() {
    try {
      $success = 0;
      $account_group_code = $this->get('account_group_code');
      $org_code = $this->get('org_code');
      $is_apv_num = empty($this->get('is_apv_num')) ? false : true;
      $vendor_code = empty($this->get('vendor_code')) ? null : $this->get('vendor_code');
      $user_org_code = $this->get('user_org_code');
      $apv_num = empty($this->get('apv_num')) ? null : $this->get('apv_num');
      $user_id = $this->get('user_id');
      $apv_status = $this->get('apv_status');

      $apv_num_or_cv_num = $this->pria_api_model->get_apv_num_or_cv_num($is_apv_num, $account_group_code, $org_code, $vendor_code, $user_org_code, $apv_num, $user_id, $apv_status);
      $success = 1;
    }
    catch(Exception $e) {
      $msg = $e->getMessage();
    }

    if($success == 1){
      $response = [
        'apv_num_or_cv_num_list' => $apv_num_or_cv_num
      ];
    }else{
      $response = [
        'msg'       => $msg,
        'flag'      => $success
      ];
    }

    $this->response($response);
  }

  public function get_all_document_type_by_ag_code_get(){
    try{
      $success        = 0;
      $account_group_code      = $this->get('account_group_code');

      if(EMPTY($account_group_code))
        throw new Exception($this->lang->line('err_required_account_group_code'));

      $document_types     = $this->pria_api_model->get_all_document_type_by_ag_code($account_group_code);

      $success  = 1;
    }catch (Exception $e){
      $msg      = $e->getMessage();      
    }

    if($success == 1){
      $response = [
        'document_type_list' => $document_types
      ];
    }else{
      $response = [
        'msg'       => $msg,
        'flag'      => $success
      ];
    }

    $this->response($response);
  }

