<?php if ( ! defined('BASEPATH')) exit('No direct script access allowed');

require(APPPATH .'/libraries/REST_Controller.php');
require(APPPATH .'/libraries/Format.php');
use Restserver\Libraries\REST_Controller;

class Dropdowns extends REST_Controller
{
  public function __construct() {
    parent::__construct();
    $this->load->model('Pria_api_model', 'pria_api_model');
    $this->load->model(CORE_USER_MANAGEMENT . '/organizations_model', 'orgs', TRUE);
  }

  public function get_all_vendors_dropdown_by_org_code_get(){
    try{
      $success  = 0;
      $org_code = $this->get('org_code');
      $user_id = $this->get('user_id');
      $acc_group = $this->get('acc_group');
      $vendor_code = !empty($this->get('vendor_code')) ? $this->get('vendor_code') : null;
      $vendors = array();

      if(!empty($user_id)) {
        $vendors     = $this->pria_api_model->get_all_vendors_for_dropdown_by_org_code_with_all($org_code, $user_id, $vendor_code, $acc_group);
      } else {
        $vendors     = $this->pria_api_model->get_all_vendors_for_dropdown_by_org_code($org_code, $acc_group);
      }

      $success  = 1;
    }catch (Exception $e){
      $msg      = $e->getMessage();      
    }

    if($success == 1){
      $response = [
        'vendors' => $vendors
      ];
    }else{
      $response = [
        'msg'       => $msg,
        'flag'      => $success
      ];
    }

    $this->response($response);
  }

  public function get_all_vendors_dropdown_scoped_get(){
    try{
      $success  = 0;
      $user_id = $this->get('user_id');

      $vendors     = $this->pria_api_model->get_all_vendors_dropdown_scoped($user_id);

      $success  = 1;
    }catch (Exception $e){
      $msg      = $e->getMessage();      
    }

    if($success == 1){
      $response = [
        'vendors' => $vendors
      ];
    }else{
      $response = [
        'msg'       => $msg,
        'flag'      => $success
      ];
    }

    $this->response($response);
  }
  
