<div class="view-content p-md">
	<div class="flat-tbl">
		<table id="tbl_soa" cellpadding="0" cellspacing="0" class="table table-default table-layout-auto highlight">
			<thead>
				<tr>
					<th width="20%">AG Code</th>
					<th width="15%">SOA Number</th>
					<th width="10%">Period From</th>
					<th width="10%">Period To</th>
					<th width="30%">Vendor</th>
					<!--th width="20%">File</th-->
					<!--th width="12%">Task ID</th-->
					<th width="15%">Action</th>
				</tr>

				<tr class="table-filters">
					<td width="20%"><input type="text" name="account_group_code" class="form-filter" placeholder="Search AG code"/></td>
					<td width="15%"><input type="text" name="soa_num" class="form-filter" placeholder="Search SOA number" /></td>
					<td width="10%"><input type="text" name="period_from" class="form-filter datepicker_start" placeholder="Search period from" /></td>
					<td width="10%"><input type="text" name="period_to" class="form-filter datepicker_end" placeholder="Search period to" /></td>
					<td width="30%"><input type="text" name="vendor" class="form-filter" placeholder="Search vendor"/></td>
					<!--td width="20%"><input type="text" name="file" class="form-filter" placeholder="Search file"/></td-->
					<!--td width="12%"><input type="text" name="task_id" class="form-filter" placeholder="Search task ID"/></td-->
					<td width="15%" class="table-actions">
						<a href="javascript:;" class="tooltipped filter-submit" data-tooltip="Search" data-position="top" data-delay="50"><i class="material-icons">search</i></a>
						<a href="javascript:;" class="tooltipped filter-cancel" data-tooltip="Reset" data-position="top" data-delay="50"><i class="material-icons">find_replace</i></a>
					</td>
				</tr>
			</thead>
		</table>
	</div>
</div>