<div>
	<div class="font-lg m-b-md">DOC Delivery and Receipt</div>
	<div class="row b-t-n m-b-n">
		<div class="col l1 m2 s2 p-l-lg">
			<input type="checkbox" class="labelauty rounded" name="dr_chk[]" value="1" />
		</div>
		<div class="col l8 m7 s8">
			<div class="font-lg">Encode DOC Goods Receipt <div class="help-text font-sm m-t-xs">assigned to <span class="font-bold">BC Admin</span></div></div>
		</div>
		<div class="col l3 m3 s2 right-align">
			<span class="badge rounded pink lighten-5">Pending</span>
		</div>
	</div>
	
	<!-- DATA ENTRY FORMS -->
	<div class="row b-t-n m-b-n">
		<div class="col l1 m2 s1"></div>
		<div class="col l11 m10 s11">
			<div class="panel-wrapper white">
				<div class="input-field">
					<div class="table-display">
						<div class="table-cell l3 m5 s5 right-align valign-middle p-r-md">			
							<label>GR No.</label>
						</div>

						<div class="table-cell l3 m6 s6 valign-middle">
							<input type="text" name="doc_gr_no" id="doc_gr_no" placeholder="Enter GR No." />
						</div>
						<div class="table-cell l6 m1 s1 valign-middle"></div>
					</div>
				</div>
				<div class="input-field">
					<div class="table-display">
						<div class="table-cell l3 m5 s5 right-align valign-middle p-r-md">			
							<label>GR Date</label>
						</div>

						<div class="table-cell l3 m6 s6 valign-middle">
							<input type="text" class="datepicker" name="doc_gr_date" id="doc_gr_date" placeholder="MM/DD/YYYY" data-max-date="0" />
						</div>
						<div class="table-cell l6 m1 s1 valign-middle"></div>
					</div>
				</div>
				<div class="input-field">
					<div class="table-display">
						<div class="table-cell s3 right-align valign-middle p-r-md"></div>

						<div class="table-cell s9 valign-middle">
							<button type="submit" class="btn">Save</button>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
