<div>
	<div class="font-lg m-b-md">Clean-Up Report</div>
	<div class="row b-t-n m-b-n">
		<div class="col l1 m2 s2 p-l-lg">
			<input type="checkbox" class="labelauty rounded" name="dr_chk[]" value="1" />
		</div>
		<div class="col l8 m7 s8">
			<div class="font-lg">Encode Clean-Up Report <div class="help-text font-sm m-t-xs">assigned to <span class="font-bold">BC Admin</span></div></div>
		</div>
		<div class="col l3 m3 s2 right-align">
			<span class="badge rounded pink lighten-5">Pending</span>
		</div>
	</div>
	
	<!-- DATA ENTRY FORMS -->
	<div class="row b-t-n m-b-n">
		<div class="col l1 m2 s1"></div>
		<div class="col l11 m10 s11">
			<div class="panel-wrapper white">
				<div class="input-field">
					<div class="table-display">
						<div class="table-cell l3 m5 s5 right-align valign-middle p-r-md">			
							<label>Actual Clean-Up Date</label>
						</div>

						<div class="table-cell l3 m6 s6 valign-middle">
							<input type="text" class="datepicker" name="actual_cleanup_date" id="actual_cleanup_date" placeholder="MM/DD/YYYY" />
						</div>
						<div class="table-cell l6 m1 s1 valign-middle"></div>
					</div>
				</div>
				<div class="input-field">
					<div class="table-display">
						<div class="table-cell l3 m5 s5 right-align valign-middle p-r-md">			
							<label class="required">Harvested Heads</label>
						</div>

						<div class="table-cell l5 m6 s6 valign-middle">
							<input type="text" name="harvested_heads" id="harvested_heads" placeholder="Enter Harvested Heads" />
						</div>
						<div class="table-cell l4 m1 s1 valign-middle"></div>
					</div>
				</div>
				<div class="input-field">
					<div class="table-display">
						<div class="table-cell l3 m5 s5 right-align valign-middle p-r-md">			
							<label>Feeds Delivered</label>
						</div>

						<div class="table-cell l5 m6 s6 valign-middle">
							<input type="text" name="feeds_delivered" id="feeds_delivered" placeholder="Enter Feeds Delivered"/>
						</div>
						<div class="table-cell l4 m1 s1 valign-middle"></div>
					</div>
				</div>
				<div class="input-field">
					<div class="table-display">
						<div class="table-cell l3 m5 s5 right-align valign-middle p-r-md">			
							<label>Feeds Used</label>
						</div>

						<div class="table-cell l5 m6 s6 valign-middle">
							<input type="text" name="feeds_used" id="feeds_used" placeholder="Enter Feeds Used"/>
						</div>
						<div class="table-cell l4 m1 s1 valign-middle"></div>
					</div>
				</div>
				<div class="input-field m-t-lg">
					<div class="table-display">
						<div class="table-cell l3 m5 s5 right-align valign-middle p-r-md">			
							<label class="required">MedVac DR No.</label>
						</div>

						<div class="table-cell l5 m6 s6 valign-middle"><a href="">DR 000001</a></div>
						<div class="table-cell l4 m1 s1 valign-middle"></div>
					</div>
				</div>
				<div class="input-field m-t-md">
					<div class="table-display">
						<div class="table-cell l3 m5 s5 right-align valign-middle p-r-md">			
							<label class="required">DOC GR No.</label>
						</div>

						<div class="table-cell l5 m6 s6 valign-middle"><a href="">GR 000001</a></div>
						<div class="table-cell l4 m1 s1 valign-middle"></div>
					</div>
				</div>
				<div class="input-field m-t-lg">
					<div class="table-display">
						<div class="table-cell s3 right-align valign-middle p-r-md"></div>

						<div class="table-cell s9 valign-middle">
							<button type="submit" class="btn">Save</button>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
