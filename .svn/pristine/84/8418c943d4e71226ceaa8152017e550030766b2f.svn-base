<div class="view-content p-md">
	<div class="flat-tbl">
		<table id="tbl_purchase_orders" cellpadding="0" cellspacing="0" class="table table-default table-layout-auto highlight">
			<thead>
				<tr>
					<th width="10%">AG Code</th>
					<th width="10%">PO Number</th>
					<th width="10%">PO Date</th>
					<th width="10%">PO Amount</th>
					<th width="10%">PR Number</th>
					<th width="15%">Vendor</th>
					<!--th width="15%">File</th-->
					<!--th width="10%">Task ID</th-->
					<th width="10%">Action</th>
				</tr>

				<tr class="table-filters">
					<td width="10%"><input type="text" name="account_group_code" class="form-filter" placeholder="Search AG code"/></td>
					<td width="10%"><input type="text" name="po_num" class="form-filter" placeholder="Search PO number" /></td>
					<td width="10%"><input type="text" name="po_date" class="form-filter datepicker" placeholder="Search PO date" /></td>
					<td width="10%"><input type="text" name="po_amount" class="form-filter" placeholder="Search PO amount" /></td>
					<td width="10%"><input type="text" name="pr_num" class="form-filter" placeholder="Search PR number" /></td>
					<td width="15%"><input type="text" name="vendor" class="form-filter" placeholder="Search vendor"/></td>
					<!--td width="15%"><input type="text" name="file" class="form-filter" placeholder="Search file"/></td-->
					<!--td width="10%"><input type="text" name="task_id" class="form-filter" placeholder="Search task ID"/></td-->
					<td width="10%" class="table-actions">
						<a href="javascript:;" class="tooltipped filter-submit" data-tooltip="Search" data-position="top" data-delay="50"><i class="material-icons">search</i></a>
						<a href="javascript:;" class="tooltipped filter-cancel" data-tooltip="Reset" data-position="top" data-delay="50"><i class="material-icons">find_replace</i></a>
					</td>
				</tr>
			</thead>
		</table>
	</div>
</div>