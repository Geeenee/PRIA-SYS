--
-- Table structure for table `module_action_roles`
--

DROP TABLE IF EXISTS `module_action_roles`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!40101 SET character_set_client = utf8 */;
CREATE TABLE `module_action_roles` (
  `module_action_id` mediumint(8) unsigned NOT NULL,
  `role_code` varchar(25) NOT NULL,
  PRIMARY KEY (`module_action_id`,`role_code`),
  KEY `role_code` (`role_code`),
  CONSTRAINT `module_action_roles_ibfk_1` FOREIGN KEY (`module_action_id`) REFERENCES `module_actions` (`module_action_id`) ON DELETE CASCADE ON UPDATE CASCADE,
  CONSTRAINT `module_action_roles_ibfk_2` FOREIGN KEY (`role_code`) REFERENCES `roles` (`role_code`) ON DELETE CASCADE ON UPDATE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=latin1;
/*!40101 SET character_set_client = @saved_cs_client */;

