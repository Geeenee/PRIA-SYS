<div class="page-title">
	<div class="table-display">
    	<div class="table-cell valign-middle s6"><h5>Submit Document</h5></div>
    		<div class="table-cell valign-middle right-align s6">
      			<div class="input-field inline p-l-xs">
	    			<button data-target="modal_submitted_document" class="btn waves-effect waves-light red lighten-1 modal_submitted_document_trigger" name="add_submitted_document" id="add_submitted_document" type="button" onclick="modal_submitted_document_init()"><i class="material-icons">library_add</i>Create New</button>
      		</div>
    	</div>
  	</div>
</div>

<div class="m-md">
	<div class="pre-datatable"></div>
  	<div>
    	<table cellpadding="0" cellspacing="0" class="table table-default table-layout-auto" id="submitted_document">
      		<thead>
	        	<tr>
	          		<th width="20%" class="center-align">Account Group</th>
	          		<th width="20%" class="center-align">Document Type</th>
			  		<th width="20%" class="center-align">Reference No.</th>
			  		<th width="20%" class="center-align">Main Document</th>
	          		<th width="20%" class="center-align">Actions</th>
	        	</tr>
	
	        	<tr class="table-filters center-align">
	          		<td width="20%"><input name="account_group" class="form-filter"></td>
	          		<td width="20%"><input name="document_type" class="form-filter"></td>
	          		<td width="20%"><input name="reference_no" class="form-filter"></td>
	          		<td width="20%"><input name="main_document" class="form-filter"></td>
	          		<td width="20%" class="table-actions">
	            		<a href="javascript:;" class="tooltipped filter-submit" data-tooltip="Search" data-position="top" data-delay="50"><i class="material-icons">search</i></a>
	            		<a href="javascript:;" class="tooltipped filter-cancel" data-tooltip="Reload" data-position="top" data-delay="50"><i class="material-icons">find_replace</i></a>
	          		</td>
	        	</tr>
      		</thead>
    	</table>    
  	</div>
</div>